<UserControl x:Class="NETworkManager.Views.MDNSDiscoverySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:icons="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             xmlns:network="clr-namespace:NETworkManager.Models.Network;assembly=NETworkManager.Models"
             xmlns:controls="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
             xmlns:wpfHelpers="clr-namespace:NETworkManager.Utilities.WPF;assembly=NETworkManager.Utilities.WPF"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:MDNSDiscoverySettingsViewModel}">
    <UserControl.Resources>
        <wpfHelpers:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{x:Static localization:Strings.ApplicationName_MDNSDiscovery}" Style="{StaticResource HeaderTextBlock}" />
        <TextBlock Text="{x:Static localization:Strings.MDNSDiscovery_ServiceTypeProfiles}" Style="{DynamicResource DefaultTextBlock}"
                   Margin="0,0,0,10" />
        <controls:MultiSelectDataGrid x:Name="DataGridServiceTypeProfiles" ItemsSource="{Binding ServiceTypeProfiles}"
                                      SelectedItem="{Binding SelectedServiceTypeProfile}"
                                      SelectedItemsList="{Binding SelectedServiceTypeProfiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="200" Margin="0,0,0,10"
                                      wpfHelpers:DataGridHelper.FillRemainingWidth="True">
            <DataGrid.Resources>
                <ContextMenu x:Key="MultiRowContextMenu" DataContext="{Binding Data, Source={StaticResource BindingProxy}}" MinWidth="150">
                    <MenuItem Header="{x:Static localization:Strings.Delete}"
                              Command="{Binding DeleteServiceTypeProfileCommand}">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=X}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
                <ContextMenu x:Key="RowContextMenu" DataContext="{Binding Data, Source={StaticResource BindingProxy}}" MinWidth="150">
                    <MenuItem Header="{x:Static localization:Strings.EditDots}"
                              Command="{Binding EditServiceTypeProfileCommand}">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Pencil}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{x:Static localization:Strings.Delete}"
                              Command="{Binding DeleteServiceTypeProfileCommand}">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=X}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static localization:Strings.Name}"
                                    Binding="{Binding (network:MDNSServiceTypeProfileInfo.Name)}"
                                    MinWidth="200"
                                    SortMemberPath="Name"
                                    Width="Auto" />
                <DataGridTextColumn Header="{x:Static localization:Strings.MDNSDiscovery_ServiceTypes}" FontFamily="{StaticResource Fonts.Family.Mono}"
                                    Binding="{Binding (network:MDNSServiceTypeProfileInfo.ServiceTypes)}"
                                    SortMemberPath="ServiceTypes"
                                    MinWidth="200" />
            </DataGrid.Columns>
            <DataGrid.InputBindings>
                <KeyBinding Command="{Binding EditServiceTypeProfileCommand}" Key="F2" />
                <KeyBinding Command="{Binding DeleteServiceTypeProfileCommand}" Key="Delete" />
            </DataGrid.InputBindings>
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                    <Setter Property="ContextMenu" Value="{StaticResource MultiRowContextMenu}" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding SelectedItems.Count, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                            Value="1">
                            <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </controls:MultiSelectDataGrid>
        <Button Command="{Binding AddServiceTypeProfileCommand}"
                Style="{StaticResource ImageWithTextButton}"
                HorizontalAlignment="Left"
                Margin="0,0,0,10">
            <Button.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Style="{StaticResource ButtonWithImageRectangle}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Plus}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Grid.Column="1" Text="{x:Static localization:Strings.AddDots}"
                               Style="{StaticResource ButtonWithImageTextBlock}" />
                </Grid>
            </Button.Content>
        </Button>
    </StackPanel>
</UserControl>
