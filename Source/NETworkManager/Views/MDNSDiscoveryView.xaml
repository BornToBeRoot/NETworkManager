<UserControl x:Class="NETworkManager.Views.MDNSDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:controls="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             xmlns:validators="clr-namespace:NETworkManager.Validators;assembly=NETworkManager.Validators"
             xmlns:helpers="clr-namespace:NETworkManager.Utilities.WPF;assembly=NETworkManager.Utilities.WPF"
             xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters">
    <UserControl.Resources>
        <converters:BooleanReverseConverter x:Key="BooleanReverseConverter" />
        <converters:BooleanToVisibilityCollapsedConverter x:Key="BooleanToVisibilityCollapsedConverter" />
        <helpers:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <Style x:Key="MonoValue" TargetType="TextBlock" BasedOn="{StaticResource DefaultTextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource Fonts.Family.Mono}" />
        </Style>
        <Style x:Key="RecordValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Value}" />
        </Style>
        <ContextMenu x:Key="RowContextMenu" DataContext="{Binding Data, Source={StaticResource BindingProxy}}" MinWidth="150">
            <MenuItem Header="{x:Static localization:Strings.CopyDots}" Style="{StaticResource CopyMenuItem}">
                <MenuItem Header="{x:Static localization:Strings.Name}" Style="{StaticResource CopyMenuItem}"
                          Command="{Binding CopyDataToClipboardCommand}" CommandParameter="{Binding SelectedResult.FullName}" />
                <MenuItem Header="{x:Static localization:Strings.Hostname}" Style="{StaticResource CopyMenuItem}"
                          Command="{Binding CopyDataToClipboardCommand}" CommandParameter="{Binding SelectedResult.Hostname}" />
                <MenuItem Header="{x:Static localization:Strings.MDNSDiscovery_ServiceType}" Style="{StaticResource CopyMenuItem}"
                          Command="{Binding CopyDataToClipboardCommand}" CommandParameter="{Binding SelectedResult.ServiceType}" />
                <MenuItem Header="{x:Static localization:Strings.Port}" Style="{StaticResource CopyMenuItem}" Command="{Binding CopyPortCommand}" />
                <MenuItem Header="{x:Static localization:Strings.IPAddresses}" Style="{StaticResource CopyMenuItem}"
                          Command="{Binding CopyDataToClipboardCommand}" CommandParameter="{Binding SelectedResult.Addresses}" />
                <MenuItem Header="{x:Static localization:Strings.MDNSDiscovery_TXTRecords}" Style="{StaticResource CopyMenuItem}"
                          Command="{Binding CopyDataToClipboardCommand}" CommandParameter="{Binding SelectedResult.TXTRecords}" />
                <MenuItem Header="{x:Static localization:Strings.Details}" Style="{StaticResource CopyMenuItem}"
                          Command="{Binding CopySelectionCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static localization:Strings.ExportDots}" Command="{Binding ExportCommand}">
                <MenuItem.Icon>
                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask><VisualBrush Stretch="Uniform" Visual="{controls:Lucide Kind=FileOutput}" /></Rectangle.OpacityMask>
                    </Rectangle>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <ContextMenu x:Key="MultiRowContextMenu" DataContext="{Binding Data, Source={StaticResource BindingProxy}}" MinWidth="150">
            <MenuItem Header="{x:Static localization:Strings.Copy}" Style="{StaticResource CopyMenuItem}" Command="{Binding CopySelectionCommand}" />
            <MenuItem Header="{x:Static localization:Strings.ExportDots}" Command="{Binding ExportCommand}">
                <MenuItem.Icon>
                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask><VisualBrush Stretch="Uniform" Visual="{controls:Lucide Kind=FileOutput}" /></Rectangle.OpacityMask>
                    </Rectangle>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <TabControl Style="{StaticResource DefaultTabControl}">
        <TabItem Header="{x:Static localization:Strings.ApplicationName_MDNSDiscovery}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static localization:Strings.NetworkInterface}" Style="{StaticResource DefaultTextBlock}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                              DisplayMemberPath="Name" Style="{StaticResource DefaultComboBox}"
                              IsReadOnly="{Binding IsRunning}" controls:ComboBoxReadOnlyBehavior.PreventSelectionWhenReadOnly="True" />
                    <Button Grid.Column="4" Command="{Binding RefreshInterfacesCommand}" Style="{StaticResource CleanButton}" ToolTip="{x:Static localization:Strings.Refresh}">
                        <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                            <Rectangle.OpacityMask><VisualBrush Stretch="Uniform" Visual="{controls:Lucide Kind=RefreshCw}" /></Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" />
                        <ColumnDefinition Width="100" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static localization:Strings.MDNSDiscovery_ServiceType}" Style="{StaticResource DefaultTextBlock}" VerticalAlignment="Center" />
                    <ComboBox x:Name="ServiceTypeInput" Grid.Column="2" IsEditable="True" ItemsSource="{Binding ServiceTypes}" FontFamily="{StaticResource Fonts.Family.Mono}"
                              Style="{StaticResource DefaultComboBox}" IsReadOnly="{Binding IsRunning}" controls:ComboBoxReadOnlyBehavior.PreventSelectionWhenReadOnly="True"
                              ToolTipService.ShowDuration="30000">
                        <ComboBox.ToolTip><ToolTip Content="{x:Static localization:Strings.MDNSDiscovery_ServiceTypeHelp}" Style="{StaticResource WrapToolTip}" /></ComboBox.ToolTip>
                        <ComboBox.Text>
                            <Binding Path="ServiceType" UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules><validators:MDNSServiceTypeValidator /></Binding.ValidationRules>
                            </Binding>
                        </ComboBox.Text>
                    </ComboBox>
                    <TextBlock Grid.Column="4" Text="{x:Static localization:Strings.DurationS}" Style="{StaticResource DefaultTextBlock}" VerticalAlignment="Center" />
                    <mah:NumericUpDown Grid.Column="6" Value="{Binding Duration}" Minimum="0" Maximum="3600" Interval="1"
                                       NumericInputMode="Numbers" IsReadOnly="{Binding IsRunning}">
                        <mah:NumericUpDown.ToolTip><ToolTip Content="{x:Static localization:Strings.MDNSDiscovery_DurationHelp}" Style="{StaticResource WrapToolTip}" /></mah:NumericUpDown.ToolTip>
                    </mah:NumericUpDown>
                    <Button Grid.Column="8" Command="{Binding BrowseCommand}" IsCancel="{Binding IsRunning}"
                            IsDefault="{Binding IsRunning, Converter={StaticResource BooleanReverseConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource HighlightedButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ServiceTypeInput, Path=(Validation.HasError)}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="16" Height="16" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,10,0">
                                <Rectangle.Resources>
                                    <VisualBrush x:Key="BrowseIcon" Stretch="Uniform" Visual="{controls:Lucide Kind=Radar}" />
                                    <VisualBrush x:Key="StopIcon" Stretch="Uniform" Visual="{controls:Lucide Kind=X}" />
                                </Rectangle.Resources>
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="OpacityMask" Value="{StaticResource BrowseIcon}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="OpacityMask" Value="{StaticResource StopIcon}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <TextBlock Text="{Binding BrowseButtonText}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <controls:StatusMessageText Grid.Row="4" Text="{Binding StatusMessage}" Level="{Binding StatusMessageLevel}" />
                <Grid Grid.Row="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Static localization:Strings.Result}" Style="{StaticResource HeaderTextBlock}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <mah:ProgressRing IsActive="{Binding IsRunning}" Style="{StaticResource ProgressRingSmall}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding DisplayedResultCount}" Style="{StaticResource DefaultTextBlock}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="250" Style="{StaticResource SearchTextBox}"
                                 helpers:SearchTextBoxHelper.EnterCommand="{Binding ApplySearchCommand}" />
                    </StackPanel>
                    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Style="{StaticResource DefaultTabControl}">
                        <TabItem Header="{x:Static localization:Strings.MDNSDiscovery_Services}">
                            <Grid>
                    <controls:MultiSelectDataGrid x:Name="ResultsGrid" ItemsSource="{Binding ResultsView}"
                                                  SelectedItem="{Binding SelectedResult}" SelectedItemsList="{Binding SelectedResults}"
                                                  helpers:DataGridHelper.FillRemainingWidth="True" RowDetailsVisibilityMode="VisibleWhenSelected">
                        <controls:MultiSelectDataGrid.Style>
                            <Style TargetType="controls:MultiSelectDataGrid" BasedOn="{StaticResource DefaultDataGrid}">
                                <Setter Property="ContextMenu" Value="{StaticResource MultiRowContextMenu}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedItems.Count, RelativeSource={RelativeSource Self}}" Value="0">
                                        <Setter Property="ContextMenu" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedItems.Count, RelativeSource={RelativeSource Self}}" Value="1">
                                        <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:MultiSelectDataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static localization:Strings.Name}" Binding="{Binding Name}" Width="220" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.MDNSDiscovery_ServiceType}" Binding="{Binding ServiceType}" Width="200" ElementStyle="{StaticResource MonoValue}" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Hostname}" Binding="{Binding Hostname}" Width="200" ElementStyle="{StaticResource MonoValue}" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Port}" Binding="{Binding Port}" Width="70" ElementStyle="{StaticResource MonoValue}" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.IPAddresses}" Binding="{Binding Addresses}" Width="220" ElementStyle="{StaticResource MonoValue}" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.TTL}" Binding="{Binding TTL}" Width="70" ElementStyle="{StaticResource MonoValue}" />
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <StackPanel Margin="10">
                                    <TextBlock Text="{Binding FullName}" Style="{StaticResource MonoValue}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{x:Static localization:Strings.MDNSDiscovery_Priority}" Style="{StaticResource DefaultTextBlock}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Priority}" Style="{StaticResource MonoValue}" Margin="0,0,20,0" />
                                        <TextBlock Text="{x:Static localization:Strings.MDNSDiscovery_Weight}" Style="{StaticResource DefaultTextBlock}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding Weight}" Style="{StaticResource MonoValue}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Static localization:Strings.MDNSDiscovery_TXTRecords}" Style="{StaticResource HeaderTextBlock}" Margin="0,0,0,10" />
                                    <TextBox Text="{Binding TXTRecords, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="250"
                                             FontFamily="{StaticResource Fonts.Family.Mono}" VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </controls:MultiSelectDataGrid>
                    <controls:EmptyStateMessage Icon="Radar" Text="{x:Static localization:Strings.MDNSDiscovery_Empty}">
                        <controls:EmptyStateMessage.Style>
                            <Style TargetType="controls:EmptyStateMessage" BasedOn="{StaticResource DefaultEmptyStateMessage}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding Results.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </controls:EmptyStateMessage.Style>
                    </controls:EmptyStateMessage>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{x:Static localization:Strings.MDNSDiscovery_Records}">
                            <Grid>
                                <controls:MultiSelectDataGrid ItemsSource="{Binding RecordsView}" SelectedItemsList="{Binding SelectedRecords}"
                                                              helpers:DataGridHelper.FillRemainingWidth="True" ContextMenu="{StaticResource MultiRowContextMenu}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{x:Static localization:Strings.Name}" Binding="{Binding Name}" Width="270" ElementStyle="{StaticResource MonoValue}" />
                                        <DataGridTextColumn Header="{x:Static localization:Strings.Type}" Binding="{Binding Type}" Width="80" ElementStyle="{StaticResource MonoValue}" />
                                        <DataGridTextColumn Header="{x:Static localization:Strings.Class}" Binding="{Binding Class}" Width="60" ElementStyle="{StaticResource MonoValue}" />
                                        <DataGridTextColumn Header="{x:Static localization:Strings.TTL}" Binding="{Binding TTL}" Width="70" ElementStyle="{StaticResource MonoValue}" />
                                        <DataGridTextColumn Header="{x:Static localization:Strings.Value}" Binding="{Binding Value}" Width="350" MinWidth="200" ElementStyle="{StaticResource RecordValue}" />
                                    </DataGrid.Columns>
                                </controls:MultiSelectDataGrid>
                                <controls:EmptyStateMessage Icon="Radar" Text="{x:Static localization:Strings.MDNSDiscovery_NoRecords}">
                                    <controls:EmptyStateMessage.Style>
                                        <Style TargetType="controls:EmptyStateMessage" BasedOn="{StaticResource DefaultEmptyStateMessage}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding Records.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </controls:EmptyStateMessage.Style>
                                </controls:EmptyStateMessage>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
                <Button Grid.Row="8" HorizontalAlignment="Left" Command="{Binding ExportCommand}" Content="{x:Static localization:Strings.ExportDots}" Style="{StaticResource DefaultButton}" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
