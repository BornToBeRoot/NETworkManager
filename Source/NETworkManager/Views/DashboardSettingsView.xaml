<UserControl x:Class="NETworkManager.Views.DashboardSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             xmlns:validators="clr-namespace:NETworkManager.Validators;assembly=NETworkManager.Validators"
             xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters"
             xmlns:wpfHelpers="clr-namespace:NETworkManager.Utilities.WPF;assembly=NETworkManager.Utilities.WPF"
             xmlns:network="clr-namespace:NETworkManager.Models.Network;assembly=NETworkManager.Models"
             xmlns:icons="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:DashboardSettingsViewModel}">
    <UserControl.Resources>
        <converters:LatencyPositionToStringConverter x:Key="LatencyPositionToStringConverter" />
        <converters:LatencyTargetToHostConverter x:Key="LatencyTargetToHostConverter" />
        <wpfHelpers:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{x:Static localization:Strings.NetworkConnection}" Style="{StaticResource HeaderTextBlock}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <mah:ToggleSwitch IsOn="{Binding ShowNetworkConnectionWidget}"
                              Header="{x:Static localization:Strings.ShowWidget}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_ShowNetworkConnectionWidget}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Style="{StaticResource InfoImageRectangle}" Width="24" Height="24"
                       HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2"
                       Text="{x:Static localization:Strings.NetworkConnectionWidgetAndStatusWindowUseTheseSettingsMessage}"
                       TextWrapping="Wrap" Style="{StaticResource InfoTextBlock}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{x:Static localization:Strings.PublicIPv4Address}"
                       Style="{DynamicResource DefaultTextBlock}" />
            <Rectangle Width="24" Height="24" ToolTip="{x:Static localization:Strings.HelpMessage_PublicIPv4Address}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <TextBox Width="250" HorizontalAlignment="Left" Margin="0,0,0,10"
                 mah:TextBoxHelper.Watermark="{x:Static localization:StaticStrings.ExampleIPv4Address}" FontFamily="{StaticResource Fonts.Family.Mono}"
                 Style="{StaticResource DefaultTextBox}">
            <TextBox.Text>
                <Binding Path="PublicIPv4Address" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:EmptyValidator ValidatesOnTargetUpdated="True" />
                        <validators:IPv4AddressValidator ValidatesOnTargetUpdated="True" />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{x:Static localization:Strings.PublicIPv6Address}"
                       Style="{DynamicResource DefaultTextBlock}" />
            <Rectangle Width="24" Height="24" ToolTip="{x:Static localization:Strings.HelpMessage_PublicIPv6Address}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <TextBox Width="250" HorizontalAlignment="Left" Margin="0,0,0,10"
                 mah:TextBoxHelper.Watermark="{x:Static localization:StaticStrings.ExampleIPv6Address}" FontFamily="{StaticResource Fonts.Family.Mono}"
                 Style="{StaticResource DefaultTextBox}">
            <TextBox.Text>
                <Binding Path="PublicIPv6Address" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:EmptyValidator ValidatesOnTargetUpdated="True" />
                        <validators:IPv6AddressValidator ValidatesOnTargetUpdated="True" />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <mah:ToggleSwitch IsOn="{Binding CheckPublicIPAddressEnabled}"
                              Header="{x:Static localization:Strings.CheckPublicIPAddress}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_CheckPublicIPAddress}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <mah:ToggleSwitch IsOn="{Binding UsePublicIPv4AddressCustomAPI}"
                              Header="{x:Static localization:Strings.UseCustomIPv4AddressAPI}"
                              IsEnabled="{Binding CheckPublicIPAddressEnabled}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_CustomPublicIPv4AddressAPI}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <TextBox Width="250" HorizontalAlignment="Left"
                 mah:TextBoxHelper.Watermark="{x:Static localization:StaticStrings.ExamplePublicIPv4AddressAPI}" FontFamily="{StaticResource Fonts.Family.Mono}"
                 Margin="0,0,0,10">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DefaultTextBox}">
                    <Setter Property="IsEnabled" Value="False" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CheckPublicIPAddressEnabled}" Value="True" />
                                <Condition Binding="{Binding UsePublicIPv4AddressCustomAPI}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
            <TextBox.Text>
                <Binding Path="CustomPublicIPv4AddressAPI" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:EmptyValidator ValidatesOnTargetUpdated="True" />
                        <validators:HttpAndHttpsUriValidator ValidatesOnTargetUpdated="True" />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <mah:ToggleSwitch IsOn="{Binding UsePublicIPv6AddressCustomAPI}"
                              Header="{x:Static localization:Strings.UseCustomIPv6AddressAPI}"
                              IsEnabled="{Binding CheckPublicIPAddressEnabled}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_CustomPublicIPv6AddressAPI}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <TextBox Width="250" HorizontalAlignment="Left"
                 mah:TextBoxHelper.Watermark="{x:Static localization:StaticStrings.ExamplePublicIPv6AddressAPI}" FontFamily="{StaticResource Fonts.Family.Mono}"
                 Margin="0,0,0,20">
            <TextBox.Style>
                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DefaultTextBox}">
                    <Setter Property="IsEnabled" Value="False" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CheckPublicIPAddressEnabled}" Value="True" />
                                <Condition Binding="{Binding UsePublicIPv6AddressCustomAPI}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.Setters>
                                <Setter Property="IsEnabled" Value="True" />
                            </MultiDataTrigger.Setters>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
            <TextBox.Text>
                <Binding Path="CustomPublicIPv6AddressAPI" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                    <Binding.ValidationRules>
                        <validators:EmptyValidator ValidatesOnTargetUpdated="True" />
                        <validators:HttpAndHttpsUriValidator ValidatesOnTargetUpdated="True" />
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>
        <TextBlock Text="{x:Static localization:Strings.SpeedTest}" Style="{StaticResource HeaderTextBlock}" />
        <mah:ToggleSwitch Header="{x:Static localization:Strings.ShowWidget}"
                          IsOn="{Binding ShowSpeedTestWidget}" Margin="0,0,0,20" />
        <TextBlock Text="{x:Static localization:Strings.Latency}" Style="{StaticResource HeaderTextBlock}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <mah:ToggleSwitch IsOn="{Binding ShowLatencyWidget}"
                              Header="{x:Static localization:Strings.ShowWidget}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_ShowLatencyWidget}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{x:Static localization:Strings.Position}"
                       Style="{DynamicResource DefaultTextBlock}" />
            <Rectangle Width="24" Height="24"
                       ToolTip="{x:Static localization:Strings.HelpMessage_LatencyPosition}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <ComboBox ItemsSource="{Binding LatencyPositions}" SelectedItem="{Binding LatencyPosition}"
                  IsEnabled="{Binding ShowLatencyWidget}"
                  Width="250" HorizontalAlignment="Left" Margin="0,0,0,10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource LatencyPositionToStringConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <mah:ToggleSwitch IsOn="{Binding CheckLatencyEnabled}"
                              Header="{x:Static localization:Strings.CheckLatency}"
                              IsEnabled="{Binding ShowLatencyWidget}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_CheckLatency}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{x:Static localization:Strings.IntervalInSeconds}"
                       Style="{DynamicResource DefaultTextBlock}" />
            <Rectangle Width="24" Height="24"
                       ToolTip="{x:Static localization:Strings.HelpMessage_LatencyInterval}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <!-- Range: LatencyTargetViewModel.MinInterval / MaxInterval -->
        <mah:NumericUpDown Value="{Binding LatencyInterval}" Minimum="1" Maximum="10" Interval="1"
                           Width="250" HorizontalAlignment="Left" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{x:Static localization:Strings.Targets}" Style="{DynamicResource DefaultTextBlock}" />
            <Rectangle Width="24" Height="24" ToolTip="{x:Static localization:Strings.HelpMessage_LatencyTargets}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <!-- Like the DNS servers of the DNS Lookup: edit / delete via context menu, F2 / Del or double-click -->
        <DataGrid ItemsSource="{Binding LatencyTargets}" SelectionMode="Single"
                  SelectedItem="{Binding SelectedLatencyTarget}" Height="200" Margin="0,0,0,10"
                  wpfHelpers:DataGridHelper.FillRemainingWidth="True">
            <DataGrid.Resources>
                <ContextMenu x:Key="RowContextMenu" DataContext="{Binding Data, Source={StaticResource BindingProxy}}" MinWidth="150">
                    <MenuItem Header="{x:Static localization:Strings.EditDots}" Command="{Binding EditLatencyTargetCommand}">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Pencil}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{x:Static localization:Strings.Delete}" Command="{Binding DeleteLatencyTargetCommand}">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=X}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static localization:Strings.Name}"
                                    Binding="{Binding (network:LatencyTargetInfo.Name)}"
                                    CanUserSort="False" MinWidth="200" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Host}" FontFamily="{StaticResource Fonts.Family.Mono}"
                                    Binding="{Binding Converter={StaticResource LatencyTargetToHostConverter}}"
                                    CanUserSort="False" MinWidth="250" />
            </DataGrid.Columns>
            <DataGrid.InputBindings>
                <KeyBinding Command="{Binding EditLatencyTargetCommand}" Key="F2" />
                <KeyBinding Command="{Binding DeleteLatencyTargetCommand}" Key="Delete" />
            </DataGrid.InputBindings>
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource MahApps.Styles.DataGridRow}">
                    <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding SelectedItems.Count, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}}"
                            Value="1">
                            <Setter Property="ContextMenu" Value="{StaticResource RowContextMenu}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <Button Command="{Binding AddLatencyTargetCommand}"
                Style="{StaticResource ImageWithTextButton}"
                HorizontalAlignment="Left"
                Margin="0,0,0,20">
            <Button.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Style="{StaticResource ButtonWithImageRectangle}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Plus}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Grid.Column="1" Text="{x:Static localization:Strings.AddDots}"
                               Style="{StaticResource ButtonWithImageTextBlock}" />
                </Grid>
            </Button.Content>
        </Button>
        <TextBlock Text="{x:Static localization:Strings.IPGeolocation}" Style="{StaticResource HeaderTextBlock}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <mah:ToggleSwitch IsOn="{Binding ShowIPGeolocationWidget}"
                              Header="{x:Static localization:Strings.ShowWidget}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_ShowIPApiWidget}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <mah:ToggleSwitch IsOn="{Binding CheckIPApiIPGeolocationEnabled}"
                              Header="{x:Static localization:Strings.CheckIPGeolocation}"
                              IsEnabled="{Binding ShowIPGeolocationWidget}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_CheckIPGeolocation}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <TextBlock Text="{x:Static localization:Strings.DNSResolver}" Style="{StaticResource HeaderTextBlock}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <mah:ToggleSwitch IsOn="{Binding ShowDNSResolverWidget}"
                              Header="{x:Static localization:Strings.ShowWidget}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_ShowIPApiWidget}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <mah:ToggleSwitch IsOn="{Binding CheckIPApiDNSResolverEnabled}"
                              Header="{x:Static localization:Strings.CheckDNSResolver}"
                              IsEnabled="{Binding ShowDNSResolverWidget}" />
            <Rectangle Width="24" Height="24" VerticalAlignment="Top"
                       ToolTip="{x:Static localization:Strings.HelpMessage_CheckDNSResolver}"
                       Style="{StaticResource HelpImageRectangle}" Margin="10,0,0,0">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </StackPanel>
    </StackPanel>
</UserControl>