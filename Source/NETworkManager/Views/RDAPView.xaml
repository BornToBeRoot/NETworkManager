<UserControl x:Class="NETworkManager.Views.RDAPView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters"
             xmlns:validators="clr-namespace:NETworkManager.Validators;assembly=NETworkManager.Validators"
             xmlns:mahAppsControls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             xmlns:wpfHelpers="clr-namespace:NETworkManager.Utilities.WPF;assembly=NETworkManager.Utilities.WPF"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:RDAPViewModel}"
             Loaded="UserControl_OnLoaded">
    <UserControl.Resources>
        <converters:BooleanToVisibilityCollapsedConverter x:Key="BooleanToVisibilityCollapsedConverter" />
        <converters:BooleanReverseConverter x:Key="BooleanReverseConverter" />
        <converters:BooleanReverseToVisibilityCollapsedConverter x:Key="BooleanReverseToVisibilityCollapsedConverter" />
        <converters:IntNotZeroToVisibilityCollapsedConverter x:Key="IntNotZeroToVisibilityCollapsedConverter" />
        <converters:RDAPQueryTypeToStringConverter x:Key="RDAPQueryTypeToStringConverter" />
        <wpfHelpers:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
        <ContextMenu x:Key="RDAPExportContextMenu" MinWidth="150">
            <MenuItem Header="{x:Static localization:Strings.ExportDots}" Command="{Binding ExportCommand}">
                <MenuItem.Icon>
                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{iconPacks:Material Kind=FileMoveOutline}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <converters:StringIsNotNullOrEmptyToVisibilityCollapsedConverter
            x:Key="StringIsNotNullOrEmptyToVisibilityCollapsedConverter" />
        <Style x:Key="RDAPSectionTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
        <Style x:Key="RDAPDataGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource DefaultDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
        </Style>
        <Style x:Key="RDAPWrapColumnStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="RDAPObjectTemplate" DataType="{x:Type viewModels:RDAPObjectViewModel}">
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderTextBlock}"
                           Visibility="{Binding Title, Converter={StaticResource StringIsNotNullOrEmptyToVisibilityCollapsedConverter}}" />
                <!-- Details -->
                <ItemsControl ItemsSource="{Binding Details}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:RDAPDetailItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="RDAPDetailName" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           Style="{StaticResource CenterTextBlock}" />
                                <TextBox Grid.Column="2" Text="{Binding Value, Mode=OneWay}"
                                         Style="{StaticResource TextBlockAsTextBox}" TextWrapping="Wrap"
                                         ContextMenu="{StaticResource CopyContextMenu}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Events -->
                <StackPanel
                    Visibility="{Binding Events.Count, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}">
                    <TextBlock Text="{x:Static localization:Strings.Events}" Style="{StaticResource RDAPSectionTextBlock}" />
                    <DataGrid ItemsSource="{Binding Events}" Style="{StaticResource RDAPDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static localization:Strings.Action}"
                                                Binding="{Binding Action}" MinWidth="200" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Date}"
                                                Binding="{Binding Date}" MinWidth="200" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Actor}"
                                                Binding="{Binding Actor}" MinWidth="150" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <!-- Nameservers -->
                <StackPanel
                    Visibility="{Binding Nameservers.Count, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}">
                    <TextBlock Text="{x:Static localization:Strings.Nameservers}"
                               Style="{StaticResource RDAPSectionTextBlock}" />
                    <DataGrid ItemsSource="{Binding Nameservers}" Style="{StaticResource RDAPDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static localization:Strings.Name}"
                                                Binding="{Binding Name}" MinWidth="250" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.IPAddresses}"
                                                Binding="{Binding IPAddresses}" MinWidth="200" Width="*"
                                                ElementStyle="{StaticResource RDAPWrapColumnStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <!-- DNSSEC -->
                <StackPanel
                    Visibility="{Binding DSData.Count, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}">
                    <TextBlock Text="{x:Static localization:Strings.DNSSEC}" Style="{StaticResource RDAPSectionTextBlock}" />
                    <DataGrid ItemsSource="{Binding DSData}" Style="{StaticResource RDAPDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static localization:Strings.KeyTag}"
                                                Binding="{Binding KeyTag}" MinWidth="80" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Algorithm}"
                                                Binding="{Binding Algorithm}" MinWidth="80" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.DigestType}"
                                                Binding="{Binding DigestType}" MinWidth="80" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Digest}"
                                                Binding="{Binding Digest}" MinWidth="200" Width="*"
                                                ElementStyle="{StaticResource RDAPWrapColumnStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <!-- Contacts -->
                <StackPanel
                    Visibility="{Binding Contacts.Count, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}">
                    <TextBlock Text="{x:Static localization:Strings.Contacts}" Style="{StaticResource RDAPSectionTextBlock}" />
                    <DataGrid ItemsSource="{Binding Contacts}" Style="{StaticResource RDAPDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static localization:Strings.Roles}"
                                                Binding="{Binding Roles}" MinWidth="120" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Handle}"
                                                Binding="{Binding Handle}" MinWidth="100" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Name}"
                                                Binding="{Binding Name}" MinWidth="150" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Organization}"
                                                Binding="{Binding Organization}" MinWidth="150" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Email}"
                                                Binding="{Binding Email}" MinWidth="150" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Phone}"
                                                Binding="{Binding Phone}" MinWidth="120" />
                            <DataGridTextColumn Header="{x:Static localization:Strings.Address}"
                                                Binding="{Binding Address}" MinWidth="200" Width="*"
                                                ElementStyle="{StaticResource RDAPWrapColumnStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <!-- Notices and remarks -->
                <StackPanel
                    Visibility="{Binding Notices.Count, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}">
                    <TextBlock Text="{x:Static localization:Strings.Notices}" Style="{StaticResource RDAPSectionTextBlock}" />
                    <ItemsControl ItemsSource="{Binding Notices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:RDAPNoticeItem}">
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BoldTextBlock}"
                                               TextWrapping="Wrap" />
                                    <TextBox Text="{Binding Description, Mode=OneWay}"
                                             Style="{StaticResource TextBlockAsTextBox}" TextWrapping="Wrap"
                                             FontWeight="Normal"
                                             ContextMenu="{StaticResource CopyContextMenu}" />
                                    <ItemsControl ItemsSource="{Binding Links}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewModels:RDAPLinkItem}">
                                                <TextBlock Text="{Binding Text}" ToolTip="{Binding Url}"
                                                           Style="{StaticResource LinkTextBlock}"
                                                           HorizontalAlignment="Left" TextWrapping="Wrap">
                                                    <TextBlock.InputBindings>
                                                        <MouseBinding
                                                            Command="{Binding Data.OpenUrlCommand, Source={StaticResource BindingProxy}}"
                                                            CommandParameter="{Binding Url}"
                                                            MouseAction="LeftClick" />
                                                    </TextBlock.InputBindings>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource HeaderTextBlock}"
                   Text="{x:Static localization:Strings.Query}" />
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Static localization:Strings.Query}"
                           Style="{DynamicResource DefaultTextBlock}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="2"
                          x:Name="ComboBoxQuery" ItemsSource="{Binding QueryHistoryView}"
                          mah:TextBoxHelper.Watermark="{Binding QueryWatermark}"
                          IsReadOnly="{Binding IsRunning}"
                          Style="{StaticResource HistoryComboBox}">
                    <ComboBox.Text>
                        <Binding Path="Query" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validators:EmptyValidator ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </ComboBox.Text>
                </ComboBox>
                <TextBlock Grid.Column="4"
                           Text="{x:Static localization:Strings.Type}"
                           Style="{DynamicResource DefaultTextBlock}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="6" ItemsSource="{Binding QueryTypes}"
                          SelectedItem="{Binding QueryType}"
                          IsEnabled="{Binding IsRunning, Converter={StaticResource BooleanReverseConverter}}"
                          Width="120">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RDAPQueryTypeToStringConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="8" Command="{Binding QueryCommand}"
                        IsDefault="{Binding IsRunning, Converter={StaticResource BooleanReverseConverter}}">
                    <Button.Resources>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ImageWithTextButton}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger
                                    Binding="{Binding Path=(Validation.HasError), ElementName=ComboBoxQuery}"
                                    Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Resources>
                    <Button.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle>
                                <Rectangle.Resources>
                                    <VisualBrush x:Key="VisualMagnify" Stretch="Uniform"
                                                 Visual="{iconPacks:Material Kind=Magnify}" />
                                </Rectangle.Resources>
                                <Rectangle.Style>
                                    <Style TargetType="{x:Type Rectangle}"
                                           BasedOn="{StaticResource ButtonWithImageRectangle}">
                                        <Setter Property="OpacityMask" Value="{StaticResource VisualMagnify}" />
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <TextBlock Grid.Column="1" Text="{x:Static localization:Strings.Query}"
                                       Style="{StaticResource ButtonWithImageTextBlock}" />
                        </Grid>
                    </Button.Content>
                </Button>
            </Grid>
            <mahAppsControls:MetroProgressBar Grid.Row="1" Margin="0,10,0,0"
                                              Foreground="{DynamicResource MahApps.Brushes.Accent}"
                                              IsIndeterminate="True">
                <mahAppsControls:MetroProgressBar.Style>
                    <Style TargetType="{x:Type mahAppsControls:MetroProgressBar}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </mahAppsControls:MetroProgressBar.Style>
            </mahAppsControls:MetroProgressBar>
            <Grid Grid.Row="2" Margin="0,10,0,0"
                  Visibility="{Binding IsStatusMessageDisplayed, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{DynamicResource MahApps.Brushes.Accent}"
                           Text="{Binding StatusMessage}"
                           Style="{DynamicResource StatusMessageTextBlock}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Margin="10,0,0,0"
                        Command="{Binding OpenInWhoisCommand}"
                        Content="{x:Static localization:Strings.OpenInWhois}"
                        Style="{StaticResource DefaultButton}"
                        Visibility="{Binding IsOpenInWhoisVisible, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            </Grid>
        </Grid>
        <Grid Grid.Row="2"
              Visibility="{Binding IsResultVisible, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource HeaderTextBlock}"
                           Text="{x:Static localization:Strings.Result}" />
                <CheckBox Grid.Column="1"
                          Content="{x:Static localization:Strings.RawJSON}"
                          IsChecked="{Binding ShowRawJSON}"
                          VerticalAlignment="Center" Margin="0,0,0,10" />
            </Grid>
            <ScrollViewer Grid.Row="1"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                          ContextMenu="{StaticResource RDAPExportContextMenu}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowRawJSON, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}">
                <ItemsControl ItemsSource="{Binding Results}"
                              ItemTemplate="{StaticResource RDAPObjectTemplate}" />
            </ScrollViewer>
            <TextBox Grid.Row="1"
                     VerticalAlignment="Stretch"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Text="{Binding RawJSON, Mode=OneWay}"
                     IsReadOnly="True"
                     Style="{StaticResource ConsoleTextBox}"
                     ContextMenu="{StaticResource CopyExportContextMenu}"
                     Visibility="{Binding ShowRawJSON, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
            <Button Grid.Row="3"
                    Command="{Binding Path=ExportCommand}"
                    HorizontalAlignment="Right">
                <Button.Style>
                    <Style TargetType="{x:Type TypeName=Button}"
                           BasedOn="{StaticResource ResourceKey=ImageWithTextButton}" />
                </Button.Style>
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Grid.Row="0"
                                   Style="{StaticResource ResourceKey=ButtonWithImageRectangle}">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform" Visual="{iconPacks:Material Kind=FileMoveOutline}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   Text="{x:Static Member=localization:Strings.ExportDots}"
                                   Style="{StaticResource ResourceKey=ButtonWithImageTextBlock}" />
                    </Grid>
                </Button.Content>
            </Button>
        </Grid>
        <TextBlock Grid.Row="2"
                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                   Text="{x:Static localization:Strings.EnterAQueryToQueryRDAPDots}"
                   Visibility="{Binding IsResultVisible, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}"
                   Style="{StaticResource HeaderTextBlock}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="10" />
    </Grid>
</UserControl>
