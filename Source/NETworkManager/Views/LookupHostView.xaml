<UserControl x:Class="NETworkManager.Views.LookupHostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:NETworkManager.Views"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:LookupHostViewModel}">
    <TabControl Style="{StaticResource DefaultTabControl}">
        <TabItem x:Name="TabItemOUILookup" Header="{x:Static localization:Strings.OUI}">
            <views:LookupOUILookupView x:Name="OUILookupView" Margin="10" />
        </TabItem>
        <TabItem x:Name="TabItemPortLookup" Header="{x:Static localization:Strings.Port}">
            <views:LookupPortLookupView x:Name="PortLookupView" Margin="10" />
        </TabItem>
    </TabControl>
</UserControl>