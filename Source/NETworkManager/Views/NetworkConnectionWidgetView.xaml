<UserControl x:Class="NETworkManager.Views.NetworkConnectionWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
             xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             xmlns:models="clr-namespace:NETworkManager.Models;assembly=NETworkManager.Models"
             xmlns:wpfHelpers="clr-namespace:NETworkManager.Utilities.WPF;assembly=NETworkManager.Utilities.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:NetworkConnectionWidgetViewModel}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CheckCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <converters:BooleanReverseToVisibilityCollapsedConverter x:Key="BooleanReverseToVisibilityCollapsedConverter" />
        <converters:BooleanToVisibilityCollapsedConverter x:Key="BooleanToVisibilityCollapsedConverter" />
        <converters:ConnectionStateToRectangleStyleConverter x:Key="ConnectionStateToRectangleStyleConverter" />
        <Style x:Key="ConnectionCheckValueTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBlockAsTextBox}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontFamily" Value="{StaticResource Fonts.Family.Mono}" />
            <!-- The full value, e.g. a long IPv6 address or DNS name cut off in a narrow window -->
            <Setter Property="ToolTip" Value="{Binding Value}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Value}" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Value}" Value="-/-">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- One row of a card (e.g. Computer > IPv4): state (loading / icon), label (Tag of the ContentControl), value.
             The label column has the same width in all rows of a card (Grid.IsSharedSizeScope on the rows). -->
        <DataTemplate x:Key="ConnectionCheckRowTemplate" DataType="{x:Type viewModels:ConnectionCheckItem}">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <mah:ProgressRing Grid.Column="0" Style="{StaticResource ProgressRingSmall}"
                                  IsActive="{Binding IsChecking}" />
                <Rectangle Grid.Column="0" Width="16" Height="16"
                           Style="{Binding State, Converter={StaticResource ConnectionStateToRectangleStyleConverter}}"
                           Visibility="{Binding IsChecking, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}"
                           ToolTip="{Binding Message}" />
                <TextBlock Grid.Column="2" Style="{StaticResource CenterTextBlock}"
                           Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ContentControl}}}" />
                <TextBox Grid.Column="4" Style="{StaticResource ConnectionCheckValueTextBox}"
                         Text="{Binding Value, Mode=OneWay}">
                    <!-- Open the value in another tool (e.g. the router in the Web Console), then copy. Declared on the
                         TextBox, so it inherits the DataContext (the ConnectionCheckItem) -->
                    <TextBox.ContextMenu>
                        <ContextMenu MinWidth="150">
                            <MenuItem Header="{x:Static localization:Strings.PortScanner}"
                                      Command="{Binding OpenApplicationCommand}"
                                      CommandParameter="{x:Static models:ApplicationName.PortScanner}"
                                      Visibility="{Binding IsIPAddress, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                                <MenuItem.Icon>
                                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=ScanLine}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static localization:Strings.PingMonitor}"
                                      Command="{Binding OpenApplicationCommand}"
                                      CommandParameter="{x:Static models:ApplicationName.PingMonitor}"
                                      Visibility="{Binding IsIPAddress, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                                <MenuItem.Icon>
                                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Radar}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static localization:Strings.Traceroute}"
                                      Command="{Binding OpenApplicationCommand}"
                                      CommandParameter="{x:Static models:ApplicationName.Traceroute}"
                                      Visibility="{Binding IsIPAddress, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                                <MenuItem.Icon>
                                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Route}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static localization:Strings.DNSLookup}"
                                      Command="{Binding OpenApplicationCommand}"
                                      CommandParameter="{x:Static models:ApplicationName.DNSLookup}">
                                <MenuItem.Icon>
                                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Globe}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static localization:Strings.RDAP}"
                                      Command="{Binding OpenApplicationCommand}"
                                      CommandParameter="{x:Static models:ApplicationName.RDAP}"
                                      Visibility="{Binding IsPublicIPAddress, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                                <MenuItem.Icon>
                                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=IdCard}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static localization:Strings.IPGeolocation}"
                                      Command="{Binding OpenApplicationCommand}"
                                      CommandParameter="{x:Static models:ApplicationName.IPGeolocation}"
                                      Visibility="{Binding IsPublicIPAddress, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                                <MenuItem.Icon>
                                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=MapPin}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{x:Static localization:Strings.WebConsole}"
                                      Command="{Binding OpenApplicationCommand}"
                                      CommandParameter="{x:Static models:ApplicationName.WebConsole}"
                                      Visibility="{Binding IsRouterIPAddress, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                                <MenuItem.Icon>
                                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=AppWindow}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{x:Static localization:Strings.Copy}"
                                      Command="{Binding CopyValueCommand}">
                                <MenuItem.Icon>
                                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                        <Rectangle.OpacityMask>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Copy}" />
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </Grid>
        </DataTemplate>
        <Style x:Key="ConnectionCheckRow" TargetType="{x:Type ContentControl}">
            <Setter Property="ContentTemplate" Value="{StaticResource ConnectionCheckRowTemplate}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>
        <Style x:Key="ConnectionCheckCardTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MessageTextBlock}">
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>
        <!-- Rows of a card: the bottom margin of the last row replaces 5 of the 10 -->
        <Style x:Key="ConnectionCheckRows" TargetType="{x:Type StackPanel}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="10,10,10,5" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- One card in three parts (computer, router, internet): rounded on the outside -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" BorderThickness="1,1,0,1" CornerRadius="8,0,0,8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
                    <Rectangle Width="32" Height="32" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Monitor}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{x:Static localization:Strings.Computer}" Style="{StaticResource ConnectionCheckCardTitle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Style="{StaticResource ConnectionCheckRows}">
                    <ContentControl Style="{StaticResource ConnectionCheckRow}" Content="{Binding ComputerIPv4}"
                                    Tag="{x:Static localization:Strings.IPv4}" />
                    <ContentControl Style="{StaticResource ConnectionCheckRow}" Content="{Binding ComputerIPv6}"
                                    Tag="{x:Static localization:Strings.IPv6}" />
                    <ContentControl Style="{StaticResource ConnectionCheckRow}" Content="{Binding ComputerDNS}"
                                    Tag="{x:Static localization:Strings.DNS}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" BorderThickness="0,1,0,1" CornerRadius="0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
                    <Rectangle Width="32" Height="32" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Router}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{x:Static localization:Strings.GatewayRouter}" Style="{StaticResource ConnectionCheckCardTitle}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Style="{StaticResource ConnectionCheckRows}">
                    <ContentControl Style="{StaticResource ConnectionCheckRow}" Content="{Binding RouterIPv4}"
                                    Tag="{x:Static localization:Strings.IPv4}" />
                    <ContentControl Style="{StaticResource ConnectionCheckRow}" Content="{Binding RouterIPv6}"
                                    Tag="{x:Static localization:Strings.IPv6}" />
                    <ContentControl Style="{StaticResource ConnectionCheckRow}" Content="{Binding RouterDNS}"
                                    Tag="{x:Static localization:Strings.DNS}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" BorderThickness="0,1,1,1" CornerRadius="0,8,8,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="32" Height="32" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Globe}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="{x:Static localization:Strings.Internet}"
                               Style="{StaticResource ConnectionCheckCardTitle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Command="{Binding CheckCommand}"
                            Style="{StaticResource CleanButton}"
                            ToolTip="{x:Static localization:Strings.Refresh}"
                            VerticalAlignment="Center">
                        <Rectangle Width="20" Height="20"
                                   wpfHelpers:ReloadAnimationHelper.IsReloading="{Binding IsChecking}">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=RefreshCw}" />
                            </Rectangle.OpacityMask>
                            <Rectangle.Style>
                                <Style TargetType="{x:Type Rectangle}">
                                    <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=IsMouseOver}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Button>
                </Grid>
                <StackPanel Grid.Row="1" Style="{StaticResource ConnectionCheckRows}">
                    <ContentControl Style="{StaticResource ConnectionCheckRow}" Content="{Binding InternetIPv4}"
                                    Tag="{x:Static localization:Strings.IPv4}" />
                    <ContentControl Style="{StaticResource ConnectionCheckRow}" Content="{Binding InternetIPv6}"
                                    Tag="{x:Static localization:Strings.IPv6}" />
                    <ContentControl Style="{StaticResource ConnectionCheckRow}" Content="{Binding InternetDNS}"
                                    Tag="{x:Static localization:Strings.DNS}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>