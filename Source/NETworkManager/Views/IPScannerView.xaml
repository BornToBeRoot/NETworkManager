                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       Background="{DynamicResource MahApps.Brushes.Gray8}"
                                                       Padding="5" Margin="0,0,5,0"
                                                       Style="{StaticResource AccentTextBlock}"
                                                       VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <Rectangle Grid.Row="1" Grid.Column="0" Height="10"
                                       Visibility="{Binding Path=IsReachable, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                            <!-- Ping -->
                            <Grid Grid.Row="2" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{x:Static localization:Strings.PingDetails}"
                                           Style="{StaticResource BoldTextBlock}"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray5}" />
                                <StackPanel Grid.Row="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Visibility="{Binding Path=Data.ScanOptions.ICMPEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanReverseToVisibilityCollapsedConverter}}">
                                    <Rectangle Width="16" Height="16"
                                               Style="{StaticResource InfoImageRectangle}" />
                                    <TextBlock Text="{x:Static localization:Strings.PingIsDisabled}"
                                               Style="{StaticResource InfoTextBlock}"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="2"
                                      Visibility="{Binding Path=Data.ScanOptions.ICMPEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}">
                                    <!-- Hidden while the ping is still running (placeholder values) -->
                                    <ListView Background="Transparent"
                                              Visibility="{Binding Path=IsPingPending, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListViewItem}"
                                                   BasedOn="{StaticResource MahApps.Styles.ListViewItem}">
                                                <Setter Property="mah:ItemHelper.HoverBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.HoverSelectedBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.SelectedBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.ActiveSelectionBackgroundBrush" Value="Transparent" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.Template>
                                            <ControlTemplate>
                                                <ItemsPresenter />
                                            </ControlTemplate>
                                        </ListView.Template>
                                        <ListViewItem>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MinWidth="120" Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static Member=localization:Strings.Timestamp}" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Path=PingInfo.Timestamp}" />
                                            </Grid>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MinWidth="120" Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static localization:Strings.Time}" />
                                                <TextBox Grid.Column="2">
                                                    <TextBox.Text>
                                                        <MultiBinding Converter="{StaticResource PingTimeToStringConverter}">
                                                            <Binding Path="PingInfo.Status" />
                                                            <Binding Path="PingInfo.Time" />
                                                        </MultiBinding>
                                                    </TextBox.Text>
                                                </TextBox>
                                            </Grid>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MinWidth="120" Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static localization:Strings.TTL}" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding PingInfo.TTL, Converter={StaticResource IntToStringConverter}}" />
                                            </Grid>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MinWidth="120" Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static localization:Strings.Bytes}" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding PingInfo.Bytes, Converter={StaticResource IntToStringConverter}}" />
                                            </Grid>
                                        </ListViewItem>
                                    </ListView>
                                </Grid>
                            </Grid>
                            <!-- Ports -->
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{x:Static localization:Strings.Ports}"
                                           Style="{StaticResource BoldTextBlock}"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray5}" />
                                <StackPanel Grid.Row="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Visibility="{Binding Path=Data.ScanOptions.PortScanEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanReverseToVisibilityCollapsedConverter}}">
                                    <Rectangle Width="16" Height="16"
                                               Style="{StaticResource InfoImageRectangle}" />
                                    <TextBlock Text="{x:Static localization:Strings.PortScanIsDisabled}"
                                               Style="{StaticResource InfoTextBlock}"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="2"
                                      Visibility="{Binding Path=Data.ScanOptions.PortScanEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}">
                                    <ListView Background="Transparent"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              ItemsSource="{Binding Path=Ports}"
                                              Visibility="{Binding Path=Ports.Count, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListViewItem}"
                                                   BasedOn="{StaticResource MahApps.Styles.ListViewItem}">
                                                <Setter Property="mah:ItemHelper.HoverBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.HoverSelectedBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.SelectedBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.ActiveSelectionBackgroundBrush" Value="Transparent" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.Template>
                                            <ControlTemplate>
                                                <ItemsPresenter />
                                            </ControlTemplate>
                                        </ListView.Template>
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Column="0" Width="16" Height="16"
                                                               Style="{Binding State, Converter={StaticResource PortOpenStyleConverter}}"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="2">
                                                        <TextBox.Text>
                                                            <MultiBinding StringFormat="{}{0}/{1}">
                                                                <Binding Path="Port" />
                                                                <Binding Path="LookupInfo.Protocol" />
                                                            </MultiBinding>
                                                        </TextBox.Text>
                                                    </TextBox>
                                                    <TextBox Grid.Column="4" Text="{Binding LookupInfo.Service}" />
                                                    <TextBox Grid.Column="6" Text="{Binding LookupInfo.Description}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <!-- Not while the port scan is still running -->
                                    <Grid Visibility="{Binding Path=IsPortScanPending, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}">
                                        <StackPanel VerticalAlignment="Top"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding Path=Ports.Count, Converter={StaticResource IntZeroToVisibilityCollapsedConverter}}">
                                            <Rectangle Width="16" Height="16" Style="{StaticResource InfoImageRectangle}" />
                                            <TextBlock Text="{x:Static localization:Strings.NoOpenPortsFound}"
                                                       Style="{StaticResource InfoTextBlock}"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <!-- NetBIOS -->
                            <Grid Grid.Row="2" Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{x:Static localization:Strings.NetBIOS}"
                                           Style="{StaticResource BoldTextBlock}"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray5}" />
                                <StackPanel Grid.Row="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Visibility="{Binding Path=Data.ScanOptions.NetBIOSEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanReverseToVisibilityCollapsedConverter}}">
                                    <Rectangle Width="16" Height="16"
                                               Style="{StaticResource InfoImageRectangle}" />
                                    <TextBlock Text="{x:Static localization:Strings.NetBIOSIsDisabled}"
                                               Style="{StaticResource InfoTextBlock}"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="2"
                                      Visibility="{Binding Path=Data.ScanOptions.NetBIOSEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}">
                                    <!-- Hidden while the NetBIOS request is still running (placeholder values) -->
                                    <ListView Background="Transparent"
                                              Visibility="{Binding Path=IsNetBIOSPending, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListViewItem}"
                                                   BasedOn="{StaticResource MahApps.Styles.ListViewItem}">
                                                <Setter Property="mah:ItemHelper.HoverBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.HoverSelectedBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.SelectedBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.ActiveSelectionBackgroundBrush" Value="Transparent" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.Template>
                                            <ControlTemplate>
                                                <ItemsPresenter />
                                            </ControlTemplate>
                                        </ListView.Template>
                                        <ListViewItem>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MinWidth="120" Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static Member=localization:Strings.ComputerName}" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Path=NetBIOSInfo.ComputerName, Converter={StaticResource ResourceKey=StringNullOrEmptyToStringConverter}}" />
                                            </Grid>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MinWidth="120" Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static Member=localization:Strings.GroupDomain}" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Path=NetBIOSInfo.GroupName, Converter={StaticResource ResourceKey=StringNullOrEmptyToStringConverter}}" />
                                            </Grid>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition MinWidth="120" Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Static Member=localization:Strings.Username}" />
                                                <TextBox Grid.Column="2"
                                                         Text="{Binding Path=NetBIOSInfo.UserName, Converter={StaticResource ResourceKey=StringNullOrEmptyToStringConverter}}" />
                                            </Grid>
                                        </ListViewItem>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </controls:MultiSelectDataGrid.RowDetailsTemplate>
        </controls:MultiSelectDataGrid>
    </Grid>
</UserControl>