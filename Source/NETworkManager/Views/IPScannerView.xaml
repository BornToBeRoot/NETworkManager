                                                                 Visual="{icons:Lucide Kind=Monitor}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrimaryRole}"
                                                     Value="{x:Static network:IPScannerHostRole.DefaultGateway}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="OpacityMask">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="Uniform"
                                                                 Visual="{icons:Lucide Kind=Router}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrimaryRole}"
                                                     Value="{x:Static network:IPScannerHostRole.DNSServer}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="OpacityMask">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="Uniform"
                                                                 Visual="{icons:Lucide Kind=Server}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PrimaryRole}"
                                                     Value="{x:Static network:IPScannerHostRole.DHCPServer}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="OpacityMask">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="Uniform"
                                                                 Visual="{icons:Lucide Kind=Network}" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Change since the previous scan of the same input, only if the result is compared with one -->
                <!-- Same design as the status of the profile import (icon + text in its color) -->
                <DataGridTemplateColumn Header="{x:Static localization:Strings.SinceLastScan}"
                                        SortMemberPath="Change"
                                        MinWidth="140"
                                        Visibility="{Binding Source={StaticResource BindingProxy}, Path=Data.HasComparison, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel x:Name="ChangePanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle x:Name="ChangeIcon" Width="12" Height="12" Margin="0,0,4,0" />
                                <TextBlock x:Name="ChangeText"
                                           Text="{Binding Change, Converter={StaticResource IPScannerHostChangeToStringConverter}}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Change}" Value="{x:Static network:IPScannerHostChange.None}">
                                    <Setter TargetName="ChangePanel" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Change}" Value="{x:Static network:IPScannerHostChange.New}">
                                    <Setter TargetName="ChangeIcon" Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                                    <Setter TargetName="ChangeIcon" Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Plus}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Change}" Value="{x:Static network:IPScannerHostChange.Gone}">
                                    <Setter TargetName="ChangeIcon" Property="Fill" Value="{DynamicResource Brushes.Status.Error}" />
                                    <Setter TargetName="ChangeIcon" Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Minus}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource Brushes.Status.Error}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Change}" Value="{x:Static network:IPScannerHostChange.MACChanged}">
                                    <Setter TargetName="ChangeIcon" Property="Fill" Value="{DynamicResource Brushes.Status.Warning}" />
                                    <Setter TargetName="ChangeIcon" Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=ArrowLeftRight}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource Brushes.Status.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Change}" Value="{x:Static network:IPScannerHostChange.MACChanged}">
                                    <Setter TargetName="ChangePanel" Property="ToolTip"
                                            Value="{Binding PreviousMACAddress, StringFormat={x:Static localization:Strings.PreviousMACAddressX}}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static localization:Strings.IPAddress}" FontFamily="{StaticResource Fonts.Family.Mono}"
                                    Binding="{Binding PingInfo.IPAddress}"
                                    SortMemberPath="PingInfo.IPAddress"
                                    MinWidth="150" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Hostname}" FontFamily="{StaticResource Fonts.Family.Mono}"
                                    SortMemberPath="Hostname"
                                    MinWidth="150">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PendingToStringConverter}">
                            <Binding Path="IsHostnamePending" />
                            <Binding Path="Hostname" Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.Visibility>
                        <MultiBinding Converter="{StaticResource BooleansOrToVisibilityCollapsedConverter}">
                            <Binding Source="{StaticResource BindingProxy}"
                                     Path="Data.ScanOptions.ResolveHostname" />
                            <Binding Source="{StaticResource BindingProxy}"
                                     Path="Data.ScanOptions.NetBIOSEnabled" />
                            <Binding Source="{StaticResource BindingProxy}"
                                     Path="Data.ScanOptions.MDNSEnabled" />
                        </MultiBinding>
                    </DataGridTextColumn.Visibility>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static localization:Strings.Time}"
                                    SortMemberPath="PingInfo.Time"
                                    Visibility="{Binding Path=Data.ScanOptions.ICMPEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}"
                                    MinWidth="100">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PingTimeToStringConverter}">
                            <Binding Path="PingInfo.Status" />
                            <Binding Path="PingInfo.Time" />
                            <Binding Path="IsPingPending" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <!-- OS: the Windows version if it was read, otherwise the guess from the TTL (icon + text, "..." while
                     running), version / hops in the tooltip -->
                <DataGridTemplateColumn Header="{x:Static localization:Strings.OS}"
                                        SortMemberPath="OSName"
                                        Visibility="{Binding Path=Data.ScanOptions.IsOSShown, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}"
                                        MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <StackPanel.ToolTip>
                                    <MultiBinding Converter="{StaticResource IPScannerOSToStringConverter}"
                                                  ConverterParameter="ToolTip">
                                        <Binding Path="OSGuess" />
                                        <Binding Path="OSGuessHops" />
                                        <Binding Path="IsPingPending" />
                                        <Binding Source="{StaticResource BindingProxy}" Path="Data.ScanOptions.OSGuessEnabled" />
                                        <Binding Path="Windows" />
                                        <Binding Path="IsWindowsPending" />
                                    </MultiBinding>
                                </StackPanel.ToolTip>
                                <Rectangle x:Name="OSIcon" Width="16" Height="16" Margin="0,0,5,0"
                                           Fill="{DynamicResource MahApps.Brushes.Gray3}"
                                           Visibility="Collapsed" />
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource IPScannerOSToStringConverter}">
                                            <Binding Path="OSGuess" />
                                            <Binding Path="OSGuessHops" />
                                            <Binding Path="IsPingPending" />
                                            <Binding Source="{StaticResource BindingProxy}" Path="Data.ScanOptions.OSGuessEnabled" />
                                            <Binding Path="Windows" />
                                            <Binding Path="IsWindowsPending" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Source={StaticResource BindingProxy}, Path=Data.ScanOptions.OSGuessEnabled}" Value="True" />
                                        <Condition Binding="{Binding OSGuess}" Value="{x:Static network:IPScannerOSGuess.Windows}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="OSIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="OSIcon" Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=AppWindow}" />
                                        </Setter.Value>
                                    </Setter>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Source={StaticResource BindingProxy}, Path=Data.ScanOptions.OSGuessEnabled}" Value="True" />
                                        <Condition Binding="{Binding OSGuess}" Value="{x:Static network:IPScannerOSGuess.LinuxUnix}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="OSIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="OSIcon" Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Terminal}" />
                                        </Setter.Value>
                                    </Setter>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Source={StaticResource BindingProxy}, Path=Data.ScanOptions.OSGuessEnabled}" Value="True" />
                                        <Condition Binding="{Binding OSGuess}" Value="{x:Static network:IPScannerOSGuess.NetworkDevice}" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="OSIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="OSIcon" Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Server}" />
                                        </Setter.Value>
                                    </Setter>
                                </MultiDataTrigger>
                                <!-- Windows version known (after the guess, so it wins) -->
                                <DataTrigger Binding="{Binding HasWindowsOS}" Value="True">
                                    <Setter TargetName="OSIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="OSIcon" Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Stretch="Uniform"
                                                         Visual="{icons:Lucide Kind=AppWindow}" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Port numbers ("..." while running), with service in the tooltip; sorted by the number of open ports -->
                <DataGridTextColumn Header="{x:Static localization:Strings.OpenPorts}" FontFamily="{StaticResource Fonts.Family.Mono}"
                                    SortMemberPath="OpenPortCount"
                                    Visibility="{Binding Path=Data.ScanOptions.PortScanEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}"
                                    MinWidth="120">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PendingToStringConverter}">
                            <Binding Path="IsPortScanPending" />
                            <Binding Path="OpenPorts" Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="ToolTip" Value="{Binding Ports, Converter={StaticResource IPScannerStatusToolTipConverter}}" />
                            <Style.Triggers>
                                <!-- No tooltip while running or without open port -->
                                <DataTrigger Binding="{Binding IsAnyPortOpen}" Value="False">
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- Domain / workgroup: of the Windows host information, otherwise of the NetBIOS answer -->
                <DataGridTextColumn Header="{x:Static localization:Strings.Domain}"
                                    SortMemberPath="Domain"
                                    Visibility="{Binding Path=Data.ScanOptions.IsDomainShown, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}"
                                    MinWidth="120">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PendingToStringConverter}">
                            <Binding Path="IsDomainPending" />
                            <Binding Path="Domain" Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <!-- Windows host information: time offset, users (the version is in the OS column) -->
                <DataGridTextColumn Header="{x:Static localization:Strings.TimeOffset}"
                                    SortMemberPath="WindowsTimeOffset"
                                    Visibility="{Binding Path=Data.ScanOptions.WindowsEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}"
                                    MinWidth="100">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PendingToStringConverter}">
                            <Binding Path="IsWindowsPending" />
                            <Binding Path="Windows" Converter="{StaticResource WindowsHostInfoToStringConverter}"
                                     ConverterParameter="TimeOffset" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <!-- More than the Kerberos limit (5 min): the logon in a domain fails -->
                                <DataTrigger Binding="{Binding Path=IsWindowsTimeOffsetLarge}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brushes.Status.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static localization:Strings.LoggedOnUsers}"
                                    SortMemberPath="WindowsUsers"
                                    Visibility="{Binding Path=Data.ScanOptions.WindowsEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}"
                                    MinWidth="150">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PendingToStringConverter}">
                            <Binding Path="IsWindowsPending" />
                            <Binding Path="WindowsUsers" Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <!-- One user per line, or why they could not be read (e.g. access denied) -->
                            <Setter Property="ToolTip"
                                    Value="{Binding Path=Windows, Converter={StaticResource WindowsHostInfoToStringConverter}, ConverterParameter=Users}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=Windows}" Value="{x:Null}">
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static localization:Strings.Web}"
                                    SortMemberPath="WebSummary"
                                    MinWidth="150">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PendingToStringConverter}">
                            <Binding Path="IsWebPagePending" />
                            <Binding Path="WebSummary" Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.Visibility>
                        <MultiBinding Converter="{StaticResource BooleansAndToVisibilityCollapsedConverter}">
                            <Binding Source="{StaticResource BindingProxy}"
                                     Path="Data.ScanOptions.PortScanEnabled" />
                            <Binding Source="{StaticResource BindingProxy}"
                                     Path="Data.ScanOptions.WebPageEnabled" />
                        </MultiBinding>
                    </DataGridTextColumn.Visibility>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="ToolTip" Value="{Binding WebURL}" />
                            <Style.Triggers>
                                <!-- No empty tooltip -->
                                <DataTrigger Binding="{Binding WebURL}" Value="">
                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static localization:Strings.SNMPName}"
                                    SortMemberPath="SNMPName"
                                    Visibility="{Binding Path=Data.ScanOptions.SNMPEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}"
                                    MinWidth="150">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PendingToStringConverter}">
                            <Binding Path="IsSNMPPending" />
                            <Binding Path="SNMPName" Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static localization:Strings.MACAddress}" FontFamily="{StaticResource Fonts.Family.Mono}"
                                    SortMemberPath="MACAddress"
                                    MinWidth="150">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PendingToStringConverter}">
                            <Binding Path="IsMACAddressPending" />
                            <Binding Path="MACAddress" Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.Visibility>
                        <MultiBinding Converter="{StaticResource BooleansOrToVisibilityCollapsedConverter}">
                            <Binding Source="{StaticResource BindingProxy}"
                                     Path="Data.ScanOptions.ResolveMACAddress" />
                            <Binding Source="{StaticResource BindingProxy}"
                                     Path="Data.ScanOptions.NetBIOSEnabled" />
                        </MultiBinding>
                    </DataGridTextColumn.Visibility>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static localization:Strings.Vendor}"
                                    SortMemberPath="Vendor"
                                    MinWidth="200">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource PendingToStringConverter}">
                            <Binding Path="IsMACAddressPending" />
                            <Binding Path="Vendor" Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.Visibility>
                        <MultiBinding Converter="{StaticResource BooleansOrToVisibilityCollapsedConverter}">
                            <Binding Source="{StaticResource BindingProxy}"
                                     Path="Data.ScanOptions.ResolveMACAddress" />
                            <Binding Source="{StaticResource BindingProxy}"
                                     Path="Data.ScanOptions.NetBIOSEnabled" />
                        </MultiBinding>
                    </DataGridTextColumn.Visibility>
                </DataGridTextColumn>
            </controls:MultiSelectDataGrid.Columns>
            <controls:MultiSelectDataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <!-- Highlight the border when the row is selected -->
                    <Border BorderThickness="1,0,1,1" Background="{DynamicResource MahApps.Brushes.Window.Background}">
                        <Border.Style>
                            <Style TargetType="{x:Type TypeName=Border}">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}}"
                                        Value="False">
                                        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid Margin="20">
                            <!-- Ping / hostnames | ports | Windows | web | NetBIOS / SNMP -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource CenterTextBlock}">
                                    <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                                </Style>
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBlockAsTextBox}">
                                    <Setter Property="ContextMenu" Value="{StaticResource CopyContextMenu}" />
                                </Style>
                                <!-- List of a section: no selection or hover, no border -->
                                <Style x:Key="HostDetailsListView" TargetType="{x:Type ListView}"
                                       BasedOn="{StaticResource MahApps.Styles.ListView}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="ItemContainerStyle">
                                        <Setter.Value>
                                            <Style TargetType="{x:Type ListViewItem}"
                                                   BasedOn="{StaticResource MahApps.Styles.ListViewItem}">
                                                <Setter Property="mah:ItemHelper.HoverBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.HoverSelectedBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.SelectedBackgroundBrush" Value="Transparent" />
                                                <Setter Property="mah:ItemHelper.ActiveSelectionBackgroundBrush" Value="Transparent" />
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListView}">
                                                <ItemsPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <!-- Line of a section: label (header) and value (content, e.g. a TextBox) -->
                                <Style x:Key="HostDetailsRow" TargetType="{x:Type HeaderedContentControl}">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type HeaderedContentControl}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition MinWidth="120" Width="Auto" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Style of the labels above (implicit styles don't apply in a template) -->
                                                    <TextBlock Grid.Column="0"
                                                               Style="{StaticResource {x:Type TextBlock}}"
                                                               Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <ContentPresenter Grid.Column="2" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>
                            <!-- Ping -->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Same height in all sections (with or without status icon) -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" MinHeight="24">
                                    <TextBlock Text="{x:Static localization:Strings.PingDetails}"
                                               Style="{StaticResource BoldTextBlock}"
                                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                               VerticalAlignment="Center" />
                                    <!-- Status icon: the host answered the probe (not while it is running) -->
                                    <Rectangle Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Style="{Binding Path=DetectedBy, Converter={StaticResource SuccessStyleConverter}, ConverterParameter=ICMP}"
                                               ToolTip="{Binding Path=DetectedBy, Converter={StaticResource IPScannerStatusToolTipConverter}, ConverterParameter=ICMP}">
                                        <Rectangle.Visibility>
                                            <MultiBinding Converter="{StaticResource BooleansAndToVisibilityCollapsedConverter}">
                                                <Binding Source="{StaticResource BindingProxy}" Path="Data.ScanOptions.ICMPEnabled" />
                                                <Binding Path="IsPingPending" Converter="{StaticResource BooleanReverseConverter}" />
                                            </MultiBinding>
                                        </Rectangle.Visibility>
                                    </Rectangle>
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Visibility="{Binding Path=Data.ScanOptions.ICMPEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanReverseToVisibilityCollapsedConverter}}">
                                    <Rectangle Width="16" Height="16"
                                               Style="{StaticResource InfoImageRectangle}" />
                                    <TextBlock Text="{x:Static localization:Strings.PingIsDisabled}"
                                               Style="{StaticResource InfoTextBlock}"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                                <Grid Grid.Row="2"
                                      Visibility="{Binding Path=Data.ScanOptions.ICMPEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}">
                                    <!-- Hidden while the ping is still running (placeholder values) -->
                                    <ListView Style="{StaticResource HostDetailsListView}"
                                              Visibility="{Binding Path=IsPingPending, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}">
                                        <ListViewItem>
                                            <HeaderedContentControl Header="{x:Static Member=localization:Strings.Timestamp}" Style="{StaticResource HostDetailsRow}">
                                                <TextBox Text="{Binding Path=PingInfo.Timestamp}" />
                                            </HeaderedContentControl>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <HeaderedContentControl Header="{x:Static localization:Strings.Time}" Style="{StaticResource HostDetailsRow}">
                                                <TextBox>
                                                    <TextBox.Text>
                                                        <MultiBinding Converter="{StaticResource PingTimeToStringConverter}">
                                                            <Binding Path="PingInfo.Status" />
                                                            <Binding Path="PingInfo.Time" />
                                                        </MultiBinding>
                                                    </TextBox.Text>
                                                </TextBox>
                                            </HeaderedContentControl>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <HeaderedContentControl Header="{x:Static localization:Strings.TTL}" Style="{StaticResource HostDetailsRow}">
                                                <TextBox Text="{Binding PingInfo.TTL, Converter={StaticResource IntToStringConverter}}" />
                                            </HeaderedContentControl>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <HeaderedContentControl Header="{x:Static localization:Strings.Bytes}" Style="{StaticResource HostDetailsRow}">
                                                <TextBox Text="{Binding PingInfo.Bytes, Converter={StaticResource IntToStringConverter}}" />
                                            </HeaderedContentControl>
                                        </ListViewItem>
                                    </ListView>
                                </Grid>
                            </Grid>
                            <!-- Ports -->
                            <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Same height in all sections (with or without status icon) -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" MinHeight="24">
                                    <TextBlock Text="{x:Static localization:Strings.Ports}"
                                               Style="{StaticResource BoldTextBlock}"
                                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                               VerticalAlignment="Center" />
