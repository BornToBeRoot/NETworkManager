                                                        <Binding Path="IsWebPagePending" Mode="OneWay" />
                                                        <Binding Path="WebCertificate" Mode="OneWay"
                                                                 Converter="{StaticResource WebCertificateToStringConverter}" ConverterParameter="Subject" />
                                                    </MultiBinding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </HeaderedContentControl>
                                    </ListViewItem>
                                    <ListViewItem>
                                        <HeaderedContentControl Header="{x:Static localization:Strings.Issuer}" Style="{StaticResource HostDetailsRow}">
                                            <TextBox>
                                                <TextBox.Text>
                                                    <MultiBinding Converter="{StaticResource PendingToStringConverter}" Mode="OneWay">
                                                        <Binding Path="IsWebPagePending" Mode="OneWay" />
                                                        <Binding Path="WebCertificate" Mode="OneWay"
                                                                 Converter="{StaticResource WebCertificateToStringConverter}" ConverterParameter="Issuer" />
                                                    </MultiBinding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </HeaderedContentControl>
                                    </ListViewItem>
                                    <ListViewItem>
                                        <HeaderedContentControl Header="{x:Static localization:Strings.ValidUntil}" Style="{StaticResource HostDetailsRow}">
                                            <TextBox>
                                                <TextBox.Text>
                                                    <MultiBinding Converter="{StaticResource PendingToStringConverter}" Mode="OneWay">
                                                        <Binding Path="IsWebPagePending" Mode="OneWay" />
                                                        <Binding Path="WebCertificate" Mode="OneWay"
                                                                 Converter="{StaticResource WebCertificateToStringConverter}" ConverterParameter="NotAfter" />
                                                    </MultiBinding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </HeaderedContentControl>
                                    </ListViewItem>
                                </ListView>
                            </Grid>
                            <!-- SNMP system information (the column shows the name) -->
                            <Grid Grid.Row="2" Grid.Column="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Same height in all sections (with or without status icon) -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" MinHeight="24">
                                    <TextBlock Text="{x:Static localization:Strings.SNMP}"
                                               Style="{StaticResource BoldTextBlock}"
                                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                               VerticalAlignment="Center" />
                                    <!-- Status icon: the host answered the probe (not while it is running) -->
                                    <Rectangle Width="16" Height="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Style="{Binding Path=DetectedBy, Converter={StaticResource SuccessStyleConverter}, ConverterParameter=SNMP}"
                                               ToolTip="{Binding Path=DetectedBy, Converter={StaticResource IPScannerStatusToolTipConverter}, ConverterParameter=SNMP}">
                                        <Rectangle.Visibility>
                                            <MultiBinding Converter="{StaticResource BooleansAndToVisibilityCollapsedConverter}">
                                                <Binding Source="{StaticResource BindingProxy}" Path="Data.ScanOptions.SNMPEnabled" />
                                                <Binding Path="IsSNMPPending" Converter="{StaticResource BooleanReverseConverter}" />
                                            </MultiBinding>
                                        </Rectangle.Visibility>
                                    </Rectangle>
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal"
                                            Visibility="{Binding Path=Data.ScanOptions.SNMPEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanReverseToVisibilityCollapsedConverter}}">
                                    <Rectangle Width="16" Height="16"
                                               Style="{StaticResource InfoImageRectangle}" />
                                    <TextBlock Text="{x:Static localization:Strings.SNMPIsDisabled}"
                                               Style="{StaticResource InfoTextBlock}"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                                <ListView Grid.Row="2" Style="{StaticResource HostDetailsListView}"
                                          Visibility="{Binding Path=Data.ScanOptions.SNMPEnabled, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}">
                                    <ListViewItem>
                                        <HeaderedContentControl Header="{x:Static localization:Strings.Name}" Style="{StaticResource HostDetailsRow}">
                                            <!-- OneWay: the values can't be set from the view -->
                                            <TextBox>
                                                <TextBox.Text>
                                                    <MultiBinding Converter="{StaticResource PendingToStringConverter}" Mode="OneWay">
                                                        <Binding Path="IsSNMPPending" Mode="OneWay" />
                                                        <Binding Path="SNMPName" Mode="OneWay"
                                                                 Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                                                    </MultiBinding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </HeaderedContentControl>
                                    </ListViewItem>
                                    <ListViewItem>
                                        <HeaderedContentControl Header="{x:Static localization:Strings.Description}" Style="{StaticResource HostDetailsRow}">
                                            <!-- OneWay: the values can't be set from the view -->
                                            <TextBox TextWrapping="Wrap">
                                                <TextBox.Text>
                                                    <MultiBinding Converter="{StaticResource PendingToStringConverter}" Mode="OneWay">
                                                        <Binding Path="IsSNMPPending" Mode="OneWay" />
                                                        <Binding Path="SNMPDescription" Mode="OneWay"
                                                                 Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                                                    </MultiBinding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </HeaderedContentControl>
                                    </ListViewItem>
                                    <ListViewItem>
                                        <HeaderedContentControl Header="{x:Static localization:Strings.SNMPLocation}" Style="{StaticResource HostDetailsRow}">
                                            <!-- OneWay: the values can't be set from the view -->
                                            <TextBox>
                                                <TextBox.Text>
                                                    <MultiBinding Converter="{StaticResource PendingToStringConverter}" Mode="OneWay">
                                                        <Binding Path="IsSNMPPending" Mode="OneWay" />
                                                        <Binding Path="SNMPLocation" Mode="OneWay"
                                                                 Converter="{StaticResource StringNullOrEmptyToStringConverter}" />
                                                    </MultiBinding>
                                                </TextBox.Text>
                                            </TextBox>
                                        </HeaderedContentControl>
                                    </ListViewItem>
                                    <!-- SNMPv3: the host answered with an error (e.g. unknown user, wrong password) -->
                                    <ListViewItem Visibility="{Binding Path=HasSNMPError, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                                        <HeaderedContentControl Header="{x:Static localization:Strings.Error}" Style="{StaticResource HostDetailsRow}">
                                            <TextBox Text="{Binding Path=SNMPError, Mode=OneWay, Converter={StaticResource SNMPV3ErrorCodeToStringConverter}}" />
                                        </HeaderedContentControl>
                                    </ListViewItem>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </controls:MultiSelectDataGrid.RowDetailsTemplate>
        </controls:MultiSelectDataGrid>
    </Grid>
</UserControl>