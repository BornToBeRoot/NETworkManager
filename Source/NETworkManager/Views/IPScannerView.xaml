<UserControl x:Class="NETworkManager.Views.IPScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:networkManager="clr-namespace:NETworkManager"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters"
             xmlns:wpfHelpers="clr-namespace:NETworkManager.Utilities.WPF;assembly=NETworkManager.Utilities.WPF"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mahAppsControls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             xmlns:validators="clr-namespace:NETworkManager.Validators;assembly=NETworkManager.Validators"
             xmlns:icons="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             xmlns:network="clr-namespace:NETworkManager.Models.Network;assembly=NETworkManager.Models"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             xmlns:internalControls="clr-namespace:NETworkManager.Controls"
             xmlns:controls="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
             xmlns:models="clr-namespace:NETworkManager.Models;assembly=NETworkManager.Models"
             xmlns:settings="clr-namespace:NETworkManager.Settings;assembly=NETworkManager.Settings"
             Loaded="UserControl_Loaded"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:IPScannerViewModel}">
    <UserControl.Resources>
        <converters:BooleanReverseConverter x:Key="BooleanReverseConverter" />
        <converters:BooleanReverseToVisibilityCollapsedConverter x:Key="BooleanReverseToVisibilityCollapsedConverter" />
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter" />
        <converters:BooleanToVisibilityCollapsedConverter x:Key="BooleanToVisibilityCollapsedConverter" />
        <converters:BooleansAndToVisibilityCollapsedConverter x:Key="BooleansAndToVisibilityCollapsedConverter" />
        <converters:BooleansOrToVisibilityCollapsedConverter x:Key="BooleansOrToVisibilityCollapsedConverter" />
        <converters:HostReachableToStringConverter x:Key="HostReachableToStringConverter" />
        <converters:HostUpStyleConverter x:Key="HostUpStyleConverter" />
        <converters:IPScannerDetectionMethodToStringConverter x:Key="IPScannerDetectionMethodToStringConverter" />
        <converters:IPScannerStatusToolTipConverter x:Key="IPScannerStatusToolTipConverter" />
        <converters:SuccessStyleConverter x:Key="SuccessStyleConverter" />
        <converters:WebCertificateToStringConverter x:Key="WebCertificateToStringConverter" />
        <converters:IPScannerHostRoleToStringConverter x:Key="IPScannerHostRoleToStringConverter" />
        <converters:IPScannerHostChangeToStringConverter x:Key="IPScannerHostChangeToStringConverter" />
        <converters:IPScannerOSToStringConverter x:Key="IPScannerOSToStringConverter" />
        <converters:IPStatusToStringConverter x:Key="IPStatusToStringConverter" />
        <converters:SNMPV3ErrorCodeToStringConverter x:Key="SNMPV3ErrorCodeToStringConverter" />
        <converters:WindowsHostInfoToStringConverter x:Key="WindowsHostInfoToStringConverter" />
        <!-- Copy: empty instead of "-/-" without a value -->
        <converters:WindowsHostInfoToStringConverter x:Key="WindowsHostInfoToCopyStringConverter" NoValue="" />
        <converters:StringIsNotNullOrEmptyToVisibilityCollapsedConverter x:Key="StringIsNotNullOrEmptyToVisibilityCollapsedConverter" />
        <converters:IntNotZeroToVisibilityCollapsedConverter x:Key="IntNotZeroToVisibilityCollapsedConverter" />
        <converters:IntToStringConverter x:Key="IntToStringConverter" />
        <converters:IntZeroToVisibilityCollapsedConverter x:Key="IntZeroToVisibilityCollapsedConverter" />
        <converters:PendingToStringConverter x:Key="PendingToStringConverter" />
        <converters:PingTimeToStringConverter x:Key="PingTimeToStringConverter" />
        <converters:PortOpenStyleConverter x:Key="PortOpenStyleConverter" />
        <converters:StringIsNotNullOrEmptyToBooleanConverter x:Key="StringIsNotNullOrEmptyToBooleanConverter" />
        <converters:HostnameHasDomainToBooleanConverter x:Key="HostnameHasDomainToBooleanConverter" />
        <converters:StringNullOrEmptyToStringConverter x:Key="StringNullOrEmptyToStringConverter" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource ResourceKey=HeaderTextBlock}"
                   Text="{x:Static Member=localization:Strings.Scan}" />
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0"
                           Text="{x:Static Member=localization:Strings.Host}"
                           Style="{DynamicResource ResourceKey=DefaultTextBlock}"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" Grid.Row="0"
                          x:Name="ComboBoxHost"
                          ItemsSource="{Binding Path=HostHistoryView}"
                          mah:TextBoxHelper.Watermark="{x:Static Member=localization:StaticStrings.ExampleHostRange}" FontFamily="{StaticResource Fonts.Family.Mono}"
                          IsReadOnly="{Binding Path=IsRunning}"
                          controls:ComboBoxPasteBehavior.ConvertMultilineToSemicolon="True"
                          Style="{StaticResource ResourceKey=HistoryComboBox}">
                    <ComboBox.Text>
                        <Binding Path="Host" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <validators:EmptyValidator ValidatesOnTargetUpdated="True" />
                                <validators:MultipleHostsRangeValidator ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </ComboBox.Text>
                </ComboBox>
                <!-- Detect the local subnet (route to the internet), or select the subnet of a network interface -->
                <mah:DropDownButton Grid.Column="4"
                                    ToolTip="{x:Static Member=localization:Strings.DetectLocalIPAddressAndSubnetmask}"
                                    IsExpanded="{Binding Path=IsLocalSubnetMenuOpen, Mode=OneWayToSource}">
                    <mah:DropDownButton.Resources>
                        <!-- The items of the submenu don't inherit the DataContext -->
                        <wpfHelpers:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
                    </mah:DropDownButton.Resources>
                    <mah:DropDownButton.Style>
                        <Style TargetType="{x:Type mah:DropDownButton}" BasedOn="{StaticResource ImageDropDrownButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=IsSubnetDetectionRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mah:DropDownButton.Style>
                    <mah:DropDownButton.Content>
                        <!-- Space to the border and to the arrow of the drop-down -->
                        <Rectangle Width="20" Height="20" Margin="10,0,10,0"
                                   Fill="{DynamicResource ResourceKey=MahApps.Brushes.Gray3}">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=EthernetPort}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </mah:DropDownButton.Content>
                    <mah:DropDownButton.Items>
                        <MenuItem Header="{x:Static localization:Strings.DetectLocalSubnet}"
                                  Command="{Binding Path=DetectSubnetCommand}" />
                        <MenuItem Header="{x:Static localization:Strings.SubnetOfNetworkInterface}"
                                  ItemsSource="{Binding Path=LocalSubnets}"
                                  DisplayMemberPath="DisplayName"
                                  Visibility="{Binding Path=LocalSubnets.Count, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource DefaultMenuItem}">
                                    <Setter Property="Command"
                                            Value="{Binding Path=Data.UseLocalSubnetCommand, Source={StaticResource BindingProxy}}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="{x:Static localization:Strings.AllLocalSubnets}"
                                  Command="{Binding Path=UseAllLocalSubnetsCommand}"
                                  Visibility="{Binding Path=LocalSubnets.Count, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}" />
                    </mah:DropDownButton.Items>
                </mah:DropDownButton>
                <!-- Quick access to the scan options: bound to the (global) settings, so the settings page and
                     the other tabs show the same values. Applies to the next scan (like the settings page). -->
                <mah:DropDownButton Grid.Column="6"
                                    ToolTip="{x:Static Member=localization:Strings.Options}">
                    <mah:DropDownButton.Style>
                        <Style TargetType="{x:Type mah:DropDownButton}" BasedOn="{StaticResource ImageDropDrownButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mah:DropDownButton.Style>
                    <mah:DropDownButton.Content>
                        <Rectangle Width="20" Height="20" Margin="10,0,10,0"
                                   Fill="{DynamicResource ResourceKey=MahApps.Brushes.Gray3}">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=SlidersHorizontal}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </mah:DropDownButton.Content>
                    <mah:DropDownButton.Items>
                        <!-- Same order as the settings page; the menu stays open to change several options -->
                        <MenuItem Header="{x:Static localization:Strings.PingHosts}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_ICMPEnabled, Mode=TwoWay}" />
                        <MenuItem Header="{x:Static localization:Strings.ResolveHostname}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_ResolveHostname, Mode=TwoWay}" />
                        <MenuItem Header="{x:Static localization:Strings.ScanPorts}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_PortScanEnabled, Mode=TwoWay}" />
                        <MenuItem IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_WindowsEnabled, Mode=TwoWay}">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static localization:Strings.ReadWindowsHostInformation}"
                                               VerticalAlignment="Center" />
                                    <!-- Beta: tested publicly (less padding, the height of a menu item) -->
                                    <TextBlock Text="{x:Static localization:Strings.Beta}"
                                               Style="{StaticResource TagTextBlock}" Padding="5,1" Margin="10,0,0,0"
                                               ToolTip="{x:Static localization:Strings.BetaFeatureMessage}" />
                                </StackPanel>
                            </MenuItem.Header>
                        </MenuItem>
                        <MenuItem Header="{x:Static localization:Strings.ScanForNetBIOS}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_NetBIOSEnabled, Mode=TwoWay}" />
                        <MenuItem Header="{x:Static localization:Strings.FindHostsInTheLocalSubnet}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_ARPEnabled, Mode=TwoWay}" />
                        <MenuItem Header="{x:Static localization:Strings.ResolveMACAddressAndVendor}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_ResolveMACAddress, Mode=TwoWay}" />
                        <MenuItem Header="{x:Static localization:Strings.ResolveMDNSHostname}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_MDNSEnabled, Mode=TwoWay}" />
                        <!-- Only open ports of the port scan are requested (like the settings page) -->
                        <MenuItem Header="{x:Static localization:Strings.ReadWebPages}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_WebPageEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_PortScanEnabled}" />
                        <MenuItem Header="{x:Static localization:Strings.ReadTheSNMPSystemInformation}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_SNMPEnabled, Mode=TwoWay}" />
                        <!-- Credentials of the tab: of the profile / group it was opened with (SNMP, Windows) or entered
                             for it (Windows) - no separator if none is shown -->
                        <Separator>
                            <Separator.Visibility>
                                <MultiBinding Converter="{StaticResource BooleansOrToVisibilityCollapsedConverter}">
                                    <Binding Source="{x:Static settings:SettingsManager.Current}" Path="IPScanner_WindowsEnabled" />
                                    <Binding Path="SNMPCredentialsInfo" Converter="{StaticResource StringIsNotNullOrEmptyToBooleanConverter}" />
                                </MultiBinding>
                            </Separator.Visibility>
                        </Separator>
                        <MenuItem Header="{Binding SNMPCredentialsInfo}"
                                  IsEnabled="False"
                                  Visibility="{Binding SNMPCredentialsInfo, Converter={StaticResource StringIsNotNullOrEmptyToVisibilityCollapsedConverter}}" />
                        <!-- Windows credentials only with Read Windows host information (not used otherwise) -->
                        <MenuItem Header="{Binding WindowsCredentialsInfo}"
                                  IsEnabled="False">
                            <MenuItem.Visibility>
                                <MultiBinding Converter="{StaticResource BooleansAndToVisibilityCollapsedConverter}">
                                    <Binding Source="{x:Static settings:SettingsManager.Current}" Path="IPScanner_WindowsEnabled" />
                                    <Binding Path="WindowsCredentialsInfo" Converter="{StaticResource StringIsNotNullOrEmptyToBooleanConverter}" />
                                </MultiBinding>
                            </MenuItem.Visibility>
                        </MenuItem>
                        <MenuItem Header="{x:Static localization:Strings.SetWindowsCredentialsDots}"
                                  Command="{Binding SetWindowsCredentialsCommand}"
                                  Visibility="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_WindowsEnabled, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
                        <Separator />
                        <MenuItem Header="{x:Static localization:Strings.ShowUnreachableIPAddressesAndPorts}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_ShowAllResults, Mode=TwoWay}" />
                        <MenuItem Header="{x:Static localization:Strings.ExpandHostView}"
                                  IsCheckable="True" StaysOpenOnClick="True"
                                  IsChecked="{Binding Source={x:Static settings:SettingsManager.Current}, Path=IPScanner_ExpandHostView, Mode=TwoWay}" />
                        <Separator />
                        <MenuItem Header="{x:Static localization:Strings.OpenSettingsDots}"
                                  Command="{Binding Path=OpenSettingsCommand}" />
                    </mah:DropDownButton.Items>
                </mah:DropDownButton>
                <Button Grid.Column="8" Grid.Row="0"
                        Command="{Binding ScanCommand}"
                        IsDefault="{Binding IsRunning, Converter={StaticResource BooleanReverseConverter}}"
                        IsCancel="{Binding IsRunning}">
                    <Button.Resources>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ImageWithTextButton}">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(Validation.HasError), ElementName=ComboBoxHost}"
                                             Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCanceling}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Resources>
                    <Button.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Grid.Row="0">
                                <Rectangle.Resources>
                                    <VisualBrush x:Key="VisualControlPlay" Stretch="Uniform"
                                                 Visual="{icons:Lucide Kind=Play}" />
                                    <VisualBrush x:Key="VisualClose" Stretch="Uniform"
                                                 Visual="{icons:Lucide Kind=X}" />
                                </Rectangle.Resources>
                                <Rectangle.Style>
                                    <Style TargetType="{x:Type Rectangle}"
                                           BasedOn="{StaticResource ButtonWithImageRectangle}">
                                        <Setter Property="OpacityMask" Value="{StaticResource VisualControlPlay}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="OpacityMask" Value="{StaticResource VisualClose}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <TextBlock Grid.Column="1" Grid.Row="0">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}"
                                           BasedOn="{StaticResource ButtonWithImageTextBlock}">
                                        <Setter Property="Text" Value="{x:Static localization:Strings.Scan}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="{x:Static localization:Strings.Cancel}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button.Content>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <StackPanel.Style>
                    <Style TargetType="{x:Type StackPanel}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <mahAppsControls:MetroProgressBar Maximum="{Binding HostsToScan}"
                                                  networkManager:SmoothProgress.Value="{Binding HostsScanned}">
                    <mahAppsControls:MetroProgressBar.Style>
                        <Style TargetType="{x:Type mahAppsControls:MetroProgressBar}" BasedOn="{StaticResource DefaultMetroProgressBar}">
                            <Setter Property="IsIndeterminate" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreparingScan}" Value="True">
                                    <Setter Property="IsIndeterminate" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCanceling}" Value="True">
                                    <Setter Property="IsIndeterminate" Value="True" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </mahAppsControls:MetroProgressBar.Style>
                </mahAppsControls:MetroProgressBar>
                <TextBlock HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreparingScan}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCanceling}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} / {1} ">
                            <Binding Path="HostsScanned" />
                            <Binding Path="HostsToScan" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="0" Grid.Row="2"
                       Foreground="{DynamicResource MahApps.Brushes.Accent}"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding IsStatusMessageDisplayed, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"
                       Style="{DynamicResource StatusMessageTextBlock}"
                       Margin="0,10,0,0" />
        </Grid>
        <!-- Header of the result: "Last scan at" / countdown (trimmed first if the header is narrow), repeat and search -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource HeaderTextBlock}"
                       Text="{x:Static localization:Strings.Result}" />
            <internalControls:RefreshStatusControl Grid.Column="1"
                                                   LastRefreshTime="{Binding LastScanTime}"
                                                   LastRefreshFormat="{x:Static localization:Strings.LastScanAtX}"
                                                   RemainingTime="{Binding Repeat.Timer.RemainingTime}"
                                                   RemainingTimeFormat="{x:Static localization:Strings.NextScanInX}"
                                                   IsRefreshing="{Binding IsRunning}"
                                                   HorizontalAlignment="Right"
                                                   Margin="20,0,0,0" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <internalControls:AutoRefreshControl IsChecked="{Binding Repeat.IsEnabled}"
                                                     ItemsSource="{Binding Repeat.Times}"
                                                     SelectedItem="{Binding Repeat.SelectedTime}"
                                                     Text="{x:Static localization:Strings.AutomaticallyScanEvery}"
                                                     Margin="20,0,0,0" />
                <TextBox Width="250"
                         Margin="20,0,0,0"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         wpfHelpers:SearchTextBoxHelper.EnterCommand="{Binding ApplySearchCommand}"
                         Style="{StaticResource SearchTextBox}" />
            </StackPanel>
        </Grid>
        <!-- Counters (once a scan was started) on their own line, the changes since the last scan don't fit into the header -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,10"
                    Visibility="{Binding Path=HostsToScan, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}">
            <TextBlock Style="{StaticResource DefaultTextBlock}"
                       Foreground="{DynamicResource MahApps.Brushes.Gray5}">
                <TextBlock.Text>
                    <Binding Path="HostsUp" StringFormat="{x:Static localization:Strings.XUp}" />
                </TextBlock.Text>
            </TextBlock>
            <TextBlock Text="·"
                       Style="{StaticResource DefaultTextBlock}"
                       Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                       Margin="6,0,6,0" />
            <TextBlock Style="{StaticResource DefaultTextBlock}"
                       Foreground="{DynamicResource MahApps.Brushes.Gray5}">
                <TextBlock.Text>
                    <Binding Path="HostsDown" StringFormat="{x:Static localization:Strings.XDown}" />
                </TextBlock.Text>
            </TextBlock>
            <!-- Changes since the previous scan of the same input (MAC changed only if there are any) -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="·"
                               Style="{StaticResource DefaultTextBlock}"
                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                               Margin="6,0,6,0" />
                    <TextBlock Style="{StaticResource DefaultTextBlock}"
                               Foreground="{DynamicResource MahApps.Brushes.Gray5}">
                        <TextBlock.Text>
                            <Binding Path="HostsNew" StringFormat="{x:Static localization:Strings.XNew}" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="·"
                               Style="{StaticResource DefaultTextBlock}"
                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                               Margin="6,0,6,0" />
                    <TextBlock Style="{StaticResource DefaultTextBlock}"
                               Foreground="{DynamicResource MahApps.Brushes.Gray5}">
                        <TextBlock.Text>
                            <Binding Path="HostsGone" StringFormat="{x:Static localization:Strings.XGone}" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding HostsMACChanged, Converter={StaticResource IntNotZeroToVisibilityCollapsedConverter}}">
                    <TextBlock Text="·"
                               Style="{StaticResource DefaultTextBlock}"
                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                               Margin="6,0,6,0" />
                    <TextBlock Style="{StaticResource DefaultTextBlock}"
                               Foreground="{DynamicResource MahApps.Brushes.Gray5}">
                        <TextBlock.Text>
                            <Binding Path="HostsMACChanged" StringFormat="{x:Static localization:Strings.XMACChanged}" />
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <controls:MultiSelectDataGrid x:Name="DataGridResults"
                                      Grid.Column="0" Grid.Row="4"
                                      ItemsSource="{Binding Path=ResultsView}"
                                      SelectedItem="{Binding Path=SelectedResult}"
                                      SelectedItemsList="{Binding Path=SelectedResults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Sorting="DataGrid_OnSorting"
                                      wpfHelpers:DataGridHelper.FillRemainingWidth="True"
                                      RowDetailsVisibilityMode="{Binding Path=HostDetailsVisibilityMode}"
                                      EnableRowVirtualization="True"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                      VirtualizingPanel.IsContainerVirtualizable="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel">
            <controls:MultiSelectDataGrid.Resources>
                <wpfHelpers:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
                <ContextMenu x:Key="RowContextMenu" DataContext="{Binding Data, Source={StaticResource BindingProxy}}" Opened="ContextMenu_Opened" MinWidth="150">
                    <MenuItem Header="{x:Static localization:Strings.Rescan}"
                              Command="{Binding RescanSelectedHostsCommand}"
                              IsEnabled="{Binding Path=IsRunning, Converter={StaticResource BooleanReverseConverter}}">
                        <MenuItem.Icon>
                            <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=RefreshCw}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{x:Static localization:Strings.PortScanner}"
                              Command="{Binding RedirectDataToApplicationCommand}"
                              CommandParameter="{x:Static models:ApplicationName.PortScanner}">
                        <MenuItem.Icon>
