                                            <HeaderedContentControl Header="{x:Static Member=localization:Strings.ComputerName}" Style="{StaticResource HostDetailsRow}">
                                                <TextBox Text="{Binding Path=NetBIOSInfo.ComputerName, Converter={StaticResource ResourceKey=StringNullOrEmptyToStringConverter}}" />
                                            </HeaderedContentControl>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <HeaderedContentControl Header="{x:Static Member=localization:Strings.GroupDomain}" Style="{StaticResource HostDetailsRow}">
                                                <TextBox Text="{Binding Path=NetBIOSInfo.GroupName, Converter={StaticResource ResourceKey=StringNullOrEmptyToStringConverter}}" />
                                            </HeaderedContentControl>
                                        </ListViewItem>
                                        <ListViewItem>
                                            <HeaderedContentControl Header="{x:Static Member=localization:Strings.Username}" Style="{StaticResource HostDetailsRow}">
                                                <TextBox Text="{Binding Path=NetBIOSInfo.UserName, Converter={StaticResource ResourceKey=StringNullOrEmptyToStringConverter}}" />
                                            </HeaderedContentControl>
                                        </ListViewItem>
                                    </ListView>
                                </Grid>
                            </Grid>
                            <!-- Hostnames of the sources (the column shows the first one: DNS, mDNS, NetBIOS) -->
                            <Grid Grid.Row="2" Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Same height in all sections (with or without status icon) -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" MinHeight="24">
                                    <TextBlock Text="{x:Static localization:Strings.Hostnames}"
                                               Style="{StaticResource BoldTextBlock}"
                                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Row="2"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
