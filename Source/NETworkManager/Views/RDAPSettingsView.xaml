<UserControl x:Class="NETworkManager.Views.RDAPSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             xmlns:rdap="clr-namespace:NETworkManager.Models.RDAP;assembly=NETworkManager.Models"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:RDAPSettingsViewModel}">
    <UserControl.Resources>
        <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
        <converters:Bytes1000ToSizeConverter x:Key="Bytes1000ToSizeConverter" />
        <converters:BooleanReverseConverter x:Key="BooleanReverseConverter" />
        <converters:BooleanToVisibilityCollapsedConverter x:Key="BooleanToVisibilityCollapsedConverter" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{x:Static localization:Strings.RDAP}" Style="{StaticResource HeaderTextBlock}" />
        <TextBlock Text="{x:Static localization:Strings.BootstrapFiles}" Style="{DynamicResource DefaultTextBlock}"
                   Margin="0,0,0,10" />
        <TextBlock Text="{x:Static localization:Strings.HelpMessage_RDAPBootstrapFiles}"
                   Style="{StaticResource InfoTextBlock}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <DataGrid ItemsSource="{Binding BootstrapFiles}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static localization:Strings.File}"
                                    Binding="{Binding (rdap:RDAPBootstrapCacheInfo.FileName)}"
                                    MinWidth="130" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Publication}"
                                    Binding="{Binding (rdap:RDAPBootstrapCacheInfo.Publication), Converter={StaticResource DateTimeToStringConverter}}"
                                    MinWidth="160" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Downloaded}"
                                    Binding="{Binding (rdap:RDAPBootstrapCacheInfo.Downloaded), Converter={StaticResource DateTimeToStringConverter}}"
                                    MinWidth="160" />
                <DataGridTextColumn Header="{x:Static localization:Strings.LastChecked}"
                                    Binding="{Binding (rdap:RDAPBootstrapCacheInfo.LastChecked), Converter={StaticResource DateTimeToStringConverter}}"
                                    MinWidth="160" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Size}"
                                    Binding="{Binding (rdap:RDAPBootstrapCacheInfo.Size), Converter={StaticResource Bytes1000ToSizeConverter}}"
                                    MinWidth="80" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Error}"
                                    Binding="{Binding (rdap:RDAPBootstrapCacheInfo.LastError)}"
                                    MinWidth="150" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Command="{Binding UpdateNowCommand}"
                    IsEnabled="{Binding IsUpdating, Converter={StaticResource BooleanReverseConverter}}"
                    Style="{StaticResource ImageWithTextButton}"
                    Margin="0,0,10,0">
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Style="{StaticResource ButtonWithImageRectangle}">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform" Visual="{iconPacks:Material Kind=Download}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Grid.Column="1" Text="{x:Static localization:Strings.UpdateNow}"
                                   Style="{StaticResource ButtonWithImageTextBlock}" />
                    </Grid>
                </Button.Content>
            </Button>
            <Button Command="{Binding OpenLocationCommand}"
                    Style="{StaticResource ImageWithTextButton}">
                <Button.Content>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Style="{StaticResource ButtonWithImageRectangle}">
                            <Rectangle.OpacityMask>
                                <VisualBrush Stretch="Uniform" Visual="{iconPacks:Material Kind=FolderOpenOutline}" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Grid.Column="1" Text="{x:Static localization:Strings.OpenLocation}"
                                   Style="{StaticResource ButtonWithImageTextBlock}" />
                    </Grid>
                </Button.Content>
            </Button>
            <mah:ProgressRing Height="20" Width="20" Margin="10,0,0,0"
                              IsActive="{Binding IsUpdating}" />
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Style="{DynamicResource StatusMessageTextBlock}"
                   Foreground="{DynamicResource MahApps.Brushes.Accent}"
                   TextWrapping="Wrap"
                   Visibility="{Binding IsStatusMessageDisplayed, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}"
                   Margin="0,0,0,10" />
        <mah:ToggleSwitch Header="{x:Static localization:Strings.FollowReferralToRegistrar}"
                          IsOn="{Binding FollowReferral}" Margin="0,10,0,10" />
        <TextBlock Text="{x:Static localization:Strings.HelpMessage_RDAPFollowReferral}"
                   Style="{StaticResource InfoTextBlock}" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="{x:Static localization:Strings.TimeoutMS}" Style="{DynamicResource DefaultTextBlock}"
                   Margin="0,10,0,10" />
        <mah:NumericUpDown Value="{Binding Timeout}" Maximum="60000" Minimum="1000" Interval="1000" />
    </StackPanel>
</UserControl>
