            <controls:MultiSelectDataGrid.Columns>
                <DataGridTemplateColumn Header="" SortMemberPath="State" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Rectangle Width="16" Height="16"
                                       Style="{Binding State, Converter={StaticResource PortOpenStyleConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static localization:Strings.IPAddress}" FontFamily="{StaticResource Fonts.Family.Mono}"
                                    Binding="{Binding IPAddress, Converter={StaticResource IPAddressToStringConverter}}"
                                    SortMemberPath="IPAddress"
                                    MinWidth="150" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Hostname}" FontFamily="{StaticResource Fonts.Family.Mono}"
                                    Binding="{Binding Hostname, Converter={StaticResource StringNullOrEmptyToStringConverter}}"
                                    SortMemberPath="Hostname"
                                    Visibility="{Binding Path=Data.ScanOptions.ResolveHostname, Source={StaticResource BindingProxy}, Converter={StaticResource ResourceKey=BooleanToVisibilityCollapsedConverter}}"
                                    MinWidth="150" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Port}" FontFamily="{StaticResource Fonts.Family.Mono}"
                                    Binding="{Binding Port}"
                                    SortMemberPath="Port"
                                    MinWidth="80" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Status}"
                                    Binding="{Binding State, Converter={StaticResource PortStateToStringConverter}}"
                                    SortMemberPath="State"
                                    MinWidth="100" />
                <!-- Change since the previous scan of the same hosts and ports, only if the result is compared -->
                <!-- Same design as the status of the profile import (icon + text in its color) -->
                <DataGridTemplateColumn Header="{x:Static localization:Strings.SinceLastScan}"
                                        SortMemberPath="Change"
                                        MinWidth="140"
                                        Visibility="{Binding Source={StaticResource BindingProxy}, Path=Data.HasComparison, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel x:Name="ChangePanel" Orientation="Horizontal" VerticalAlignment="Center">
                                <Rectangle x:Name="ChangeIcon" Width="12" Height="12" Margin="0,0,4,0" />
                                <TextBlock x:Name="ChangeText"
                                           Text="{Binding Change, Converter={StaticResource PortScannerPortChangeToStringConverter}}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Change}" Value="{x:Static network:PortScannerPortChange.None}">
                                    <Setter TargetName="ChangePanel" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Change}" Value="{x:Static network:PortScannerPortChange.Opened}">
                                    <Setter TargetName="ChangeIcon" Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                                    <Setter TargetName="ChangeIcon" Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Plus}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Change}" Value="{x:Static network:PortScannerPortChange.Closed}">
                                    <Setter TargetName="ChangeIcon" Property="Fill" Value="{DynamicResource Brushes.Status.Error}" />
                                    <Setter TargetName="ChangeIcon" Property="OpacityMask">
                                        <Setter.Value>
                                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Minus}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ChangeText" Property="Foreground" Value="{DynamicResource Brushes.Status.Error}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static localization:Strings.Protocol}"
                                    Binding="{Binding LookupInfo.Protocol}"
                                    SortMemberPath="LookupInfo.Protocol"
                                    MinWidth="100" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Service}"
                                    Binding="{Binding LookupInfo.Service}"
                                    SortMemberPath="LookupInfo.Service"
                                    MinWidth="100" />
                <DataGridTextColumn Header="{x:Static localization:Strings.Description}"
                                    Binding="{Binding LookupInfo.Description}"
                                    SortMemberPath="LookupInfo.Description"
                                    MinWidth="200" />
            </controls:MultiSelectDataGrid.Columns>
        </controls:MultiSelectDataGrid>
    </Grid>
</UserControl>