                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.Icon>
                                                            <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                                                <Rectangle.OpacityMask>
                                                                    <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Eye}" />
                                                                </Rectangle.OpacityMask>
                                                            </Rectangle>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="{x:Static localization:Strings.SNMP}"
                                                              Command="{Binding Path=Data.RedirectDataToApplicationCommand, Source={StaticResource BindingProxy}}">
                                                        <MenuItem.CommandParameter>
                                                            <MultiBinding Converter="{StaticResource MultiValueToArrayConverter}">
                                                                <Binding Source="{x:Static models:ApplicationName.SNMP}" />
                                                                <Binding />
                                                            </MultiBinding>
                                                        </MenuItem.CommandParameter>
                                                        <MenuItem.Icon>
                                                            <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                                                                <Rectangle.OpacityMask>
                                                                    <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Server}" />
                                                                </Rectangle.OpacityMask>
                                                            </Rectangle>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="{x:Static localization:Strings.AddProfileDots}"
