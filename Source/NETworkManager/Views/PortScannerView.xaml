                                                               Style="{DynamicResource ResourceKey=DefaultTextBlock}" />
                                                    <TextBlock Text="·"
                                                               Style="{DynamicResource ResourceKey=DefaultTextBlock}"
                                                               Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                                                               Margin="6,0,6,0" />
                                                    <!-- Open ports of the host, also while the scan is running -->
                                                    <TextBlock Style="{DynamicResource ResourceKey=DefaultTextBlock}"
                                                               Foreground="{DynamicResource MahApps.Brushes.Gray5}">
                                                        <TextBlock.Text>
                                                            <MultiBinding
                                                                Converter="{StaticResource PortScannerGroupOpenPortsConverter}">
                                                                <Binding />
                                                                <Binding Path="ItemCount" />
                                                                <Binding Path="Data.OpenPortsPerHost"
                                                                         Source="{StaticResource BindingProxy}" />
                                                                <Binding Source="{x:Static localization:Strings.XOpen}" />
                                                                <!-- Changes when a rescanned port changed in place -->
                                                                <Binding Path="Data.OpenPortsPerHostVersion"
                                                                         Source="{StaticResource BindingProxy}" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Expander.Header>
