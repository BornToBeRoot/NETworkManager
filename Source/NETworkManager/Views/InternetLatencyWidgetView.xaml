<UserControl x:Class="NETworkManager.Views.InternetLatencyWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
             xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:models="clr-namespace:NETworkManager.Models;assembly=NETworkManager.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="clr-namespace:NETworkManager.Settings;assembly=NETworkManager.Settings"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             mc:Ignorable="d" x:Name="UserControlInternetLatency"
             d:DataContext="{d:DesignInstance viewModels:InternetLatencyWidgetViewModel}">
    <UserControl.Resources>
        <converters:BooleanReverseToVisibilityCollapsedConverter x:Key="BooleanReverseToVisibilityCollapsedConverter" />
        <converters:BooleanToVisibilityCollapsedConverter x:Key="BooleanToVisibilityCollapsedConverter" />
        <converters:StringNullOrEmptyToStringConverter x:Key="StringNullOrEmptyToStringConverter" />
        <converters:StringIsNotNullOrEmptyToVisibilityCollapsedConverter
            x:Key="StringIsNotNullOrEmptyToVisibilityCollapsedConverter" />
        <!-- Open the host in another tool, copy it. One menu per tile, bound to the target of the clicked tile -->
        <ContextMenu x:Key="TargetContextMenu" x:Shared="False" MinWidth="150"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     d:DataContext="{d:DesignInstance viewModels:InternetLatencyTargetViewModel}">
            <MenuItem Header="{x:Static localization:Strings.PingMonitor}" Command="{Binding OpenCommand}"
                      CommandParameter="{x:Static models:ApplicationName.PingMonitor}">
                <MenuItem.Icon>
                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Radar}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static localization:Strings.Traceroute}" Command="{Binding OpenCommand}"
                      CommandParameter="{x:Static models:ApplicationName.Traceroute}">
                <MenuItem.Icon>
                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Route}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{x:Static localization:Strings.DNSLookup}" Command="{Binding OpenCommand}"
                      CommandParameter="{x:Static models:ApplicationName.DNSLookup}">
                <MenuItem.Icon>
                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Globe}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{x:Static localization:Strings.Copy}" Command="{Binding CopyCommand}">
                <MenuItem.Icon>
                    <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Copy}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    <Border Style="{StaticResource CardBorder}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Header: live values, no refresh button -->
            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="32" Height="32" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Activity}" />
                        </Rectangle.OpacityMask>
                    </Rectangle>
                    <TextBlock Text="{x:Static localization:Strings.InternetLatency}"
                               Style="{StaticResource MessageTextBlock}" Margin="10,0,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CopyAllCommand}"
                        Style="{StaticResource CleanButton}"
                        ToolTip="{x:Static localization:Strings.CopyAll}"
                        VerticalAlignment="Center"
                        Visibility="{Binding Source={x:Static Member=settings:SettingsManager.Current}, Path=Dashboard_CheckInternetLatency, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                    <Rectangle Width="20" Height="20">
                        <Rectangle.OpacityMask>
                            <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Copy}" />
                        </Rectangle.OpacityMask>
                        <Rectangle.Style>
                            <Style TargetType="{x:Type Rectangle}">
                                <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray5}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                </Button>
            </Grid>
            <!-- Targets side by side (wide, own row) or one below the other (narrow, next to the speed test), see
                 IsCompact; check enabled -->
            <Grid Grid.Row="1" Margin="10"
                  Visibility="{Binding Source={x:Static Member=settings:SettingsManager.Current}, Path=Dashboard_CheckInternetLatency, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                <ItemsControl ItemsSource="{Binding Targets}" AlternationCount="3" Grid.IsSharedSizeScope="True"
                              Visibility="{Binding HasTargets, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
                    <ItemsControl.Style>
                        <Style TargetType="{x:Type ItemsControl}">
                            <!-- Wide: the dividers between the targets have a padding of 10, the first target starts at
                                 the left edge -->
                            <Setter Property="Margin" Value="-10,0,0,0" />
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=UserControlInternetLatency}" Value="True">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="ItemsPanel">
                                        <Setter.Value>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="1" />
                                            </ItemsPanelTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:InternetLatencyTargetViewModel}">
                            <!-- One line per target: dot, name, value, chart. Transparent background: the tooltip and
                                 the context menu work on the whole target -->
                            <Border Background="Transparent" ContextMenu="{StaticResource TargetContextMenu}">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <!-- Wide: divider in front of every target except the first -->
                                        <Setter Property="Padding" Value="10,0" />
                                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brushes.Surface.Border}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType={x:Type ContentPresenter}}}" Value="0">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                            </DataTrigger>
                                            <!-- Narrow: one below the other, no dividers -->
                                            <DataTrigger Binding="{Binding IsCompact, ElementName=UserControlInternetLatency}" Value="True">
                                                <Setter Property="Padding" Value="0,4" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ToolTip>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static localization:Strings.Host}" />
                                        <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Host}"
                                                   FontFamily="{StaticResource Fonts.Family.Mono}" />
                                        <TextBlock Grid.Column="0" Grid.Row="1" Text="{x:Static localization:Strings.IPAddress}" />
                                        <TextBlock Grid.Column="2" Grid.Row="1"
                                                   Text="{Binding ResolvedIPAddress, Converter={StaticResource StringNullOrEmptyToStringConverter}}"
                                                   FontFamily="{StaticResource Fonts.Family.Mono}" />
                                        <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Static localization:Strings.Minimum}" />
                                        <TextBlock Grid.Column="2" Grid.Row="2"
                                                   Text="{Binding Statistics.Minimum, StringFormat='{}{0} ms', TargetNullValue='-/-'}" />
                                        <TextBlock Grid.Column="0" Grid.Row="3" Text="{x:Static localization:Strings.AverageTime}" />
                                        <TextBlock Grid.Column="2" Grid.Row="3"
                                                   Text="{Binding Statistics.Average, StringFormat='{}{0:F0} ms', TargetNullValue='-/-'}" />
                                        <TextBlock Grid.Column="0" Grid.Row="4" Text="{x:Static localization:Strings.Maximum}" />
                                        <TextBlock Grid.Column="2" Grid.Row="4"
                                                   Text="{Binding Statistics.Maximum, StringFormat='{}{0} ms', TargetNullValue='-/-'}" />
                                        <TextBlock Grid.Column="0" Grid.Row="5" Text="{x:Static localization:Strings.PacketLoss}" />
                                        <TextBlock Grid.Column="2" Grid.Row="5"
                                                   Text="{Binding Statistics.PacketLoss, StringFormat='{}{0:F0} %'}" />
                                        <!-- Host name not resolved -->
                                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="6" Margin="0,10,0,0"
                                                   Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxWidth="300"
                                                   Foreground="{DynamicResource Brushes.Status.Error}"
                                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyToVisibilityCollapsedConverter}}" />
                                    </Grid>
                                </Border.ToolTip>
                                <!-- Name and value columns have the same width in all targets (values aligned when they
                                     are one below the other), the chart gets the rest -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" MaxWidth="150" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                                        <ColumnDefinition Width="*" MinWidth="0" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Style="{StaticResource StatusDot}" Tag="{Binding StatusLevel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource DefaultTextBlock}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                               Style="{StaticResource MessageTextBlock}"
                                               HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="NoWrap"
                                               Margin="10,0,10,0" />
                                    <lvc:CartesianChart Grid.Column="3" Height="24"
                                                        Background="Transparent"
                                                        Series="{Binding Series}"
                                                        XAxes="{Binding XAxes}"
                                                        YAxes="{Binding YAxes}"
                                                        DrawMarginFrame="{x:Null}"
                                                        TooltipPosition="Hidden"
                                                        AnimationsSpeed="00:00:00"
                                                        RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- All hosts empty -->
                <icons:EmptyStateMessage Icon="Activity"
                                         Text="{x:Static localization:Strings.NoInternetLatencyTargetsConfiguredMessage}"
                                         HorizontalAlignment="Center"
                                         Visibility="{Binding HasTargets, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}" />
            </Grid>
            <!-- Check disabled (default): enable it here or in the settings -->
            <StackPanel Grid.Row="1" Margin="10" HorizontalAlignment="Center"
                        Visibility="{Binding Source={x:Static Member=settings:SettingsManager.Current}, Path=Dashboard_CheckInternetLatency, Converter={StaticResource ResourceKey=BooleanReverseToVisibilityCollapsedConverter}}">
                <TextBlock Text="{x:Static localization:Strings.InternetLatencyWidgetDisabledMessage}"
                           Style="{StaticResource MessageTextBlock}" Margin="0,0,0,10" />
                <Button Command="{Binding EnableCheckCommand}" HorizontalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ImageWithTextButton}" />
                    </Button.Resources>
                    <Button.Content>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Style="{StaticResource ResourceKey=ButtonWithImageRectangle}">
                                <Rectangle.OpacityMask>
                                    <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Check}" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Grid.Column="1" Style="{StaticResource ButtonWithImageTextBlock}"
                                       Text="{x:Static localization:Strings.Enable}" />
                        </Grid>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
