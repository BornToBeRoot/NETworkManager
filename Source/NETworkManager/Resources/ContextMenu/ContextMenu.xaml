<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
                    xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
                    xmlns:models="clr-namespace:NETworkManager.Models;assembly=NETworkManager.Models">
    <ContextMenu x:Key="CutCopyPasteContextMenu" MinWidth="150">
        <MenuItem Header="{x:Static localization:Strings.Cut}" Command="Cut">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16">
                    <Rectangle.Style>
                        <Style TargetType="{x:Type Rectangle}">
                            <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                        </Style>
                    </Rectangle.Style>
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Scissors}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static localization:Strings.Copy}" Command="Copy">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16">
                    <Rectangle.Style>
                        <Style TargetType="{x:Type Rectangle}">
                            <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                        </Style>
                    </Rectangle.Style>
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Copy}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static localization:Strings.Paste}" Command="Paste">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16">
                    <Rectangle.Style>
                        <Style TargetType="{x:Type Rectangle}">
                            <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                        </Style>
                    </Rectangle.Style>
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=ClipboardPaste}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <ContextMenu x:Key="CopyContextMenu" MinWidth="150">
        <MenuItem Header="{x:Static localization:Strings.Copy}" Command="Copy">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16">
                    <Rectangle.Style>
                        <Style TargetType="{x:Type Rectangle}">
                            <Setter Property="Fill" Value="{DynamicResource  MahApps.Brushes.Gray3}" />
                        </Style>
                    </Rectangle.Style>
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Copy}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <ContextMenu x:Key="CopyExportContextMenu" MinWidth="150">
        <MenuItem Header="{x:Static localization:Strings.Copy}" Command="Copy">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16">
                    <Rectangle.Style>
                        <Style TargetType="{x:Type Rectangle}">
                            <Setter Property="Fill" Value="{DynamicResource  MahApps.Brushes.Gray3}" />
                        </Style>
                    </Rectangle.Style>
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Copy}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static localization:Strings.ExportDots}" Command="{Binding ExportCommand}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16">
                    <Rectangle.Style>
                        <Style TargetType="{x:Type Rectangle}">
                            <Setter Property="Fill" Value="{DynamicResource  MahApps.Brushes.Gray3}" />
                        </Style>
                    </Rectangle.Style>
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=FileOutput}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>
    <!-- Open a public IP address (read-only text box) in another tool, like the network connection widget. The text box
         sets the command (parameter: ApplicationName) as Tag -->
    <ContextMenu x:Key="OpenIPAddressContextMenu" MinWidth="150">
        <MenuItem Header="{x:Static localization:Strings.PortScanner}"
                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{x:Static models:ApplicationName.PortScanner}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=ScanLine}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static localization:Strings.PingMonitor}"
                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{x:Static models:ApplicationName.PingMonitor}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Radar}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static localization:Strings.Traceroute}"
                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{x:Static models:ApplicationName.Traceroute}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Route}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static localization:Strings.DNSLookup}"
                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{x:Static models:ApplicationName.DNSLookup}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Globe}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static localization:Strings.RDAP}"
                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{x:Static models:ApplicationName.RDAP}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=IdCard}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static localization:Strings.IPGeolocation}"
                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{x:Static models:ApplicationName.IPGeolocation}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=MapPin}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static localization:Strings.Copy}" Command="Copy">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Copy}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <!-- Open the network address of a subnet (e.g. the EDNS client subnet x.x.x.0, not a host) in RDAP / IP Geolocation,
         the text box sets the command as Tag -->
    <ContextMenu x:Key="OpenSubnetAddressContextMenu" MinWidth="150">
        <MenuItem Header="{x:Static localization:Strings.RDAP}"
                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{x:Static models:ApplicationName.RDAP}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=IdCard}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static localization:Strings.IPGeolocation}"
                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{x:Static models:ApplicationName.IPGeolocation}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=MapPin}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static localization:Strings.Copy}" Command="Copy">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Copy}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <!-- Open a DNS name (read-only text box) in the DNS Lookup, the text box sets the command as Tag -->
    <ContextMenu x:Key="OpenDNSNameContextMenu" MinWidth="150">
        <MenuItem Header="{x:Static localization:Strings.DNSLookup}"
                  Command="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                  CommandParameter="{x:Static models:ApplicationName.DNSLookup}">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Globe}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="{x:Static localization:Strings.Copy}" Command="Copy">
            <MenuItem.Icon>
                <Rectangle Width="16" Height="16" Fill="{DynamicResource MahApps.Brushes.Gray3}">
                    <Rectangle.OpacityMask>
                        <VisualBrush Stretch="Uniform" Visual="{icons:Lucide Kind=Copy}" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>
</ResourceDictionary>