<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:controls="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls"
                    xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters">
    <Style x:Key="DefaultComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="FontSize" Value="14" />
        <!--<Setter Property="BorderThickness" Value="0,0,0,1" />-->
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource DefaultErrorTemplate}" />
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource DefaultComboBox}" />

    <Style x:Key="EditableComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource DefaultComboBox}">
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="ContextMenu" Value="{StaticResource CutCopyPasteContextMenu}" />
    </Style>
    <Style x:Key="HistoryComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource DefaultComboBox}">
        <Setter Property="IsEditable" Value="True" />
        <!-- The history is changed in place, removing the selected entry would clear the text -->
        <Setter Property="controls:ComboBoxHistoryBehavior.KeepTextWhenSelectedItemIsRemoved" Value="True" />
        <Setter Property="ContextMenu" Value="{StaticResource CutCopyPasteContextMenu}" />
    </Style>

    <!-- Input with history and profiles (name and description, e.g. ports), grouped - see InputSuggestions. Looks like
         the suggestions of the run command (group header, profile in two lines). -->
    <converters:StringIsNotNullOrEmptyToVisibilityCollapsedConverter
        x:Key="ComboBoxStringIsNotNullOrEmptyToVisibilityCollapsedConverter" />
    <DataTemplate x:Key="ComboBoxGroupHeaderTemplate">
        <TextBlock Text="{Binding Path=Name}"
                   FontSize="14"
                   Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                   Margin="5,10,0,5" />
    </DataTemplate>
    <DataTemplate x:Key="InputSuggestionTemplate">
        <!-- As wide as the ComboBox (the drop down would grow with a long description), long text is trimmed -->
        <StackPanel Margin="0,2,0,2"
                    MaxWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}">
            <TextBlock Text="{Binding Path=Text}"
                       TextTrimming="CharacterEllipsis" />
            <!-- Profile: description (e.g. ports, IP addresses) in the second line -->
            <TextBlock Text="{Binding Path=Description}"
                       ToolTip="{Binding Path=Description}"
                       Foreground="{DynamicResource MahApps.Brushes.Gray5}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding Path=Description, Converter={StaticResource ComboBoxStringIsNotNullOrEmptyToVisibilityCollapsedConverter}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>