    <!-- Status of a value in a list (dot in front of the text, e.g. firewall action, TCP state): the level as Tag
         (StatusLevel, e.g. via FirewallRuleActionToStatusLevelConverter), gray if neutral -->
    <Style x:Key="StatusDot" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource MahApps.Brushes.Gray5}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static converters:StatusLevel.Success}">
                <Setter Property="Fill" Value="{DynamicResource Brushes.Status.Success}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static converters:StatusLevel.Warning}">
                <Setter Property="Fill" Value="{DynamicResource Brushes.Status.Warning}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static converters:StatusLevel.Error}">
                <Setter Property="Fill" Value="{DynamicResource Brushes.Status.Error}" />
            </Trigger>
        </Style.Triggers>
    </Style>

