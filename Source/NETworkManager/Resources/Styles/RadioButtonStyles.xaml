<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <Style x:Key="DefaultRadioButton" TargetType="{x:Type RadioButton}"
           BasedOn="{StaticResource MahApps.Styles.RadioButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray8}" />
        <!-- Disabled: the normal colors (MahApps: gray / Accent2), dimmed like the inputs and buttons, see trigger -->
        <Setter Property="mah:RadioButtonHelper.BackgroundDisabled" Value="{DynamicResource MahApps.Brushes.ThemeBackground}" />
        <Setter Property="mah:RadioButtonHelper.BorderBrushDisabled" Value="{DynamicResource MahApps.Brushes.Gray8}" />
        <Setter Property="mah:RadioButtonHelper.CheckGlyphFillDisabled" Value="{DynamicResource MahApps.Brushes.Highlight}" />
        <Setter Property="mah:RadioButtonHelper.CheckGlyphStrokeDisabled" Value="{DynamicResource MahApps.Brushes.Highlight}" />
        <Setter Property="mah:RadioButtonHelper.ForegroundDisabled" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource DefaultRadioButton}" />
</ResourceDictionary>