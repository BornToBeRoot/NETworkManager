<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
                    xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
                    xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters"
                    xmlns:controls="clr-namespace:NETworkManager.Controls">
    <converters:ApplicationNameToIconBrushConverter x:Key="EmbeddedWindowDragPresenterIconConverter" />
    <converters:BooleansOrConverter x:Key="EmbeddedWindowDragPresenterIsDraggingConverter" />

    <!-- See EmbeddedWindowDragPresenter: placeholder of an embedded window while a tab is dragged -->
    <Style TargetType="{x:Type controls:EmbeddedWindowDragPresenter}">
        <Setter Property="Focusable" Value="False" />
        <!-- Dragging (drag state from Dragablz): the window of this tab is dragged (a solitary tab, e.g. just dragged
             out) or a dragged window can be dropped into the layout of this tab (drop zones shown) -->
        <Setter Property="IsDragging">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource EmbeddedWindowDragPresenterIsDraggingConverter}">
                    <Binding Path="IsDraggingWindow"
                             RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type dragablz:TabablzControl}}" />
                    <Binding Path="IsParticipatingInDrag"
                             RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type dockablz:Layout}}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EmbeddedWindowDragPresenter}">
                    <Grid>
                        <StackPanel x:Name="PART_Placeholder"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Hidden">
                            <Rectangle Width="48" Height="48"
                                       Fill="{DynamicResource MahApps.Brushes.Gray5}"
                                       OpacityMask="{Binding ApplicationName, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmbeddedWindowDragPresenterIconConverter}}" />
                            <!-- Title of the tab (see EmbeddedWindowDragPresenter.Title) -->
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{DynamicResource HeaderTextBlock}"
                                       Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" />
                        </StackPanel>
                        <ContentPresenter x:Name="PART_Content" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>