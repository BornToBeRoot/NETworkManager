<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
                    xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters"
                    xmlns:controls="clr-namespace:NETworkManager.Controls">
    <converters:ApplicationNameToIconBrushConverter x:Key="EmbeddedWindowDragPresenterIconConverter" />

    <!-- See EmbeddedWindowDragPresenter: placeholder of an embedded window while a tab is dragged -->
    <Style TargetType="{x:Type controls:EmbeddedWindowDragPresenter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EmbeddedWindowDragPresenter}">
                    <Grid>
                        <StackPanel x:Name="PART_Placeholder"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Hidden">
                            <Rectangle Width="48" Height="48"
                                       Fill="{DynamicResource MahApps.Brushes.Gray5}"
                                       OpacityMask="{Binding ApplicationName, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmbeddedWindowDragPresenterIconConverter}}" />
                            <!-- Title of the shown (selected) tab -->
                            <TextBlock Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Style="{DynamicResource HeaderTextBlock}"
                                       Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource AncestorType={x:Type dragablz:TabablzControl}}}" />
                        </StackPanel>
                        <ContentPresenter x:Name="PART_Content" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>