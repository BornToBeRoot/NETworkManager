<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="clr-namespace:NETworkManager.Controls;assembly=NETworkManager.Controls">
    <Style x:Key="DefaultTextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
    </Style>

    <!-- Section header (e.g. Firewall rules, sections of the settings): 16 SemiBold in the text color (was 18 in the
         light header font, gray) -->
    <Style x:Key="HeaderTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="InfoTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ProfileGroupTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
    </Style>

    <!-- Short label next to a value or setting, e.g. the protocol of a Ping Monitor host (ICMP) or a beta setting -->
    <Style x:Key="TagTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AccentTextBlock}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ErrorTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brushes.Status.Error}" />
    </Style>

    <!-- Message in an empty area (e.g. no results): 16 regular, gray (was 18 in the light header font) -->
    <Style x:Key="MessageTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="10,0" />
    </Style>

    <!-- Message in an empty area with an icon above (e.g. no rules found, restart as administrator): gray icon
         (IconSize, default 40) + the text like MessageTextBlock. Implicit style for icons:EmptyStateMessage -->
    <Style x:Key="DefaultEmptyStateMessage" TargetType="{x:Type icons:EmptyStateMessage}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type icons:EmptyStateMessage}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <icons:LucideIcon x:Name="Icon"
                                          Kind="{TemplateBinding Icon}"
                                          Width="{TemplateBinding IconSize}"
                                          Height="{TemplateBinding IconSize}"
                                          Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                          Opacity="0.7"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,12" />
                        <TextBlock Text="{TemplateBinding Text}"
                                   Style="{StaticResource MessageTextBlock}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="None">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type icons:EmptyStateMessage}" BasedOn="{StaticResource DefaultEmptyStateMessage}" />

    <Style x:Key="BoldTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="WrapTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="StatusMessageTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource WrapTextBlock}" />

    <!-- Status message of a tool (icons:StatusMessageText): icon (16) + text in the color of the level - info gray,
         success green, warning yellow, error red. Implicit style -->
    <Style x:Key="DefaultStatusMessageText" TargetType="{x:Type icons:StatusMessageText}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type icons:StatusMessageText}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <icons:LucideIcon x:Name="Icon" Grid.Column="0"
                                          Kind="Info"
                                          Width="16" Height="16"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Top"
                                          Margin="0,2,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{TemplateBinding Text}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Style="{StaticResource WrapTextBlock}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Level" Value="Success">
                            <Setter TargetName="Icon" Property="Kind" Value="CircleCheck" />
                        </Trigger>
                        <Trigger Property="Level" Value="Warning">
                            <Setter TargetName="Icon" Property="Kind" Value="TriangleAlert" />
                        </Trigger>
                        <Trigger Property="Level" Value="Error">
                            <Setter TargetName="Icon" Property="Kind" Value="CircleAlert" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Level" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource Brushes.Status.Success}" />
            </Trigger>
            <Trigger Property="Level" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Brushes.Status.Warning}" />
            </Trigger>
            <Trigger Property="Level" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource Brushes.Status.Error}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type icons:StatusMessageText}" BasedOn="{StaticResource DefaultStatusMessageText}" />

    <Style x:Key="ConsoleTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Fonts.Family.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
    </Style>
    
    <!-- TextBlock style for buttons with images and text -->
    <Style x:Key="ButtonWithImageTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="Margin" Value="10,5" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="CenterTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="LinkTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent2}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Link inside a TextBlock, looks like LinkTextBlock but is keyboard accessible (Tab + Enter).
        Usage: <TextBlock><Hyperlink Command="..." Style="{StaticResource LinkHyperlink}"><Run Text="..." /></Hyperlink></TextBlock>
    -->
    <Style x:Key="LinkHyperlink" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
        <Setter Property="TextDecorations" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent2}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DisabledTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DefaultTextBlock}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>