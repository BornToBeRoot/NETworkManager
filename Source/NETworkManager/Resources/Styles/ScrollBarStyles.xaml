<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DefaultScrollBar" TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MahApps.Styles.ScrollBar}">
        <Style.Resources>
            <!-- Thumb (used by the template of MahApps via DynamicResource): rounded, without the white overlay of
                 MahApps on mouse over (60 %) / drag (80 %), which made it almost white in the dark theme. -->
            <Style x:Key="MahApps.Styles.Thumb.ScrollBar" TargetType="{x:Type Thumb}">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Thumb}" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border x:Name="ThumbVisual"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource CornerRadius.Control}"
                                    Opacity="0.8"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbVisual" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbVisual" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ThumbVisual" Property="Opacity" Value="0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="Auto" />
            </Trigger>
            <DataTrigger
                Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}"
                Value="False">
                <Setter Property="Opacity" Value="0.25" />
            </DataTrigger>
            <!-- Mouse over: a bit stronger, not the full (light) gray of the thumb -->
            <DataTrigger
                Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}"
                Value="True">
                <Setter Property="Opacity" Value="0.6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type TypeName=ScrollBar}" BasedOn="{StaticResource ResourceKey=DefaultScrollBar}" />
</ResourceDictionary>