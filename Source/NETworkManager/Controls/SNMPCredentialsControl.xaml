<UserControl x:Class="NETworkManager.Controls.SNMPCredentialsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:interactivity="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:NETworkManager.Converters;assembly=NETworkManager.Converters"
             xmlns:validators="clr-namespace:NETworkManager.Validators;assembly=NETworkManager.Validators"
             xmlns:wpfHelpers="clr-namespace:NETworkManager.Utilities.WPF;assembly=NETworkManager.Utilities.WPF"
             xmlns:localization="clr-namespace:NETworkManager.Localization.Resources;assembly=NETworkManager.Localization"
             xmlns:viewModels="clr-namespace:NETworkManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:SNMPCredentialsViewModel}">
    <!-- Override of the SNMP version and credentials (profile / group dialog): "Version" enables the override,
         v1 / v2c with a community, v3 with a user. Same layout as the SNMP section of the dialogs. -->
    <UserControl.Resources>
        <converters:BooleanToVisibilityCollapsedConverter x:Key="BooleanToVisibilityCollapsedConverter" />
        <converters:BooleanReverseToVisibilityCollapsedConverter x:Key="BooleanReverseToVisibilityCollapsedConverter" />
        <!-- Warning: the password is saved as plain text (the profile file is not encrypted) -->
        <Style x:Key="PasswordWarningRectangle" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource WarnImageRectangle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="ToolTip" Value="{x:Static localization:Strings.WarningMessage_ProfileFileNotEncryptedStoringPasswords}" />
            <Setter Property="Visibility"
                    Value="{Binding IsProfileFileEncrypted, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}" />
        </Style>
        <Style x:Key="FieldTextBlock" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DisabledTextBlock}">
            <Setter Property="Margin" Value="24,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Version (enables the override) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0"
                      Content="{x:Static localization:Strings.Version}"
                      IsChecked="{Binding IsOverridden}"
                      Style="{StaticResource DefaultCheckBox}" />
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding Versions}"
                      SelectedItem="{Binding Version}"
                      IsEnabled="{Binding IsOverridden}" />
        </Grid>
        <!-- v1 / v2c: community -->
        <Grid Margin="0,10,0,0"
              Visibility="{Binding IsV3, Converter={StaticResource BooleanReverseToVisibilityCollapsedConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static localization:Strings.Community}"
                       Style="{StaticResource FieldTextBlock}" />
            <PasswordBox Grid.Column="2" IsEnabled="{Binding IsOverridden}">
                <PasswordBox.Style>
                    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource DefaultPasswordBox}">
                        <Setter Property="mah:TextBoxHelper.Watermark" Value="{x:Static localization:Strings.NotChanged}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCommunityEmpty}" Value="True">
                                <Setter Property="mah:TextBoxHelper.Watermark"
                                        Value="{x:Static localization:StaticStrings.ExampleSNMPCommunity}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
                <interactivity:Interaction.Behaviors>
                    <wpfHelpers:PasswordBoxBindingBehavior
                        Password="{Binding Community, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </interactivity:Interaction.Behaviors>
            </PasswordBox>
            <Rectangle Grid.Column="3" Style="{StaticResource PasswordWarningRectangle}">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </Grid>
        <!-- v3: security, username -->
        <Grid Margin="0,10,0,0"
              Visibility="{Binding IsV3, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static localization:Strings.Security}"
                       Style="{StaticResource FieldTextBlock}" />
            <ComboBox Grid.Column="2" Grid.Row="0"
                      ItemsSource="{Binding Securities}"
                      SelectedItem="{Binding Security}"
                      IsEnabled="{Binding IsOverridden}" />
            <TextBlock Grid.Column="0" Grid.Row="2" Text="{x:Static localization:Strings.Username}"
                       Style="{StaticResource FieldTextBlock}" />
            <TextBox Grid.Column="2" Grid.Row="2"
                     mah:TextBoxHelper.Watermark="{x:Static localization:StaticStrings.ExampleUsername}"
                     IsEnabled="{Binding IsOverridden}"
                     Style="{StaticResource DefaultTextBox}">
                <TextBox.Text>
                    <Binding Path="Username" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <validators:EmptyValidator ValidatesOnTargetUpdated="True" />
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox.Text>
            </TextBox>
        </Grid>
        <!-- v3 with authentication: provider, password -->
        <Grid Margin="0,10,0,0"
              Visibility="{Binding HasAuth, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static localization:Strings.Auth}"
                       Style="{StaticResource FieldTextBlock}" />
            <ComboBox Grid.Column="2" Grid.Row="0"
                      ItemsSource="{Binding AuthenticationProviders}"
                      SelectedItem="{Binding AuthenticationProvider}"
                      IsEnabled="{Binding IsOverridden}" />
            <PasswordBox Grid.Column="2" Grid.Row="2" IsEnabled="{Binding IsOverridden}">
                <PasswordBox.Style>
                    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource DefaultPasswordBox}">
                        <Setter Property="mah:TextBoxHelper.Watermark" Value="{x:Static localization:Strings.NotChanged}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAuthEmpty}" Value="True">
                                <Setter Property="mah:TextBoxHelper.Watermark"
                                        Value="{x:Static localization:StaticStrings.ExampleSNMPAuthSecret}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
                <interactivity:Interaction.Behaviors>
                    <wpfHelpers:PasswordBoxBindingBehavior
                        Password="{Binding Auth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </interactivity:Interaction.Behaviors>
            </PasswordBox>
            <Rectangle Grid.Column="3" Grid.Row="2" Style="{StaticResource PasswordWarningRectangle}">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </Grid>
        <!-- v3 with privacy: provider, password -->
        <Grid Margin="0,10,0,0"
              Visibility="{Binding HasPriv, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Grid.Row="0" Text="{x:Static localization:Strings.Priv}"
                       Style="{StaticResource FieldTextBlock}" />
            <ComboBox Grid.Column="2" Grid.Row="0"
                      ItemsSource="{Binding PrivacyProviders}"
                      SelectedItem="{Binding PrivacyProvider}"
                      IsEnabled="{Binding IsOverridden}" />
            <PasswordBox Grid.Column="2" Grid.Row="2" IsEnabled="{Binding IsOverridden}">
                <PasswordBox.Style>
                    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource DefaultPasswordBox}">
                        <Setter Property="mah:TextBoxHelper.Watermark" Value="{x:Static localization:Strings.NotChanged}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPrivEmpty}" Value="True">
                                <Setter Property="mah:TextBoxHelper.Watermark"
                                        Value="{x:Static localization:StaticStrings.ExampleSNMPPrivSecret}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
                <interactivity:Interaction.Behaviors>
                    <wpfHelpers:PasswordBoxBindingBehavior
                        Password="{Binding Priv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </interactivity:Interaction.Behaviors>
            </PasswordBox>
            <Rectangle Grid.Column="3" Grid.Row="2" Style="{StaticResource PasswordWarningRectangle}">
                <Rectangle.Resources>
                    <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource HelpToolTip}" />
                </Rectangle.Resources>
            </Rectangle>
        </Grid>
    </StackPanel>
</UserControl>
