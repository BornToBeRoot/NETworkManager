<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>NETworkManager.Tests</RootNamespace>
        <AssemblyName>NETworkManager.Tests</AssemblyName>
        <!-- Windows SDK version as TargetPlatformVersion instead of in the TFM (net10.0-windows10.0.22621.0), otherwise
             Dependabot can't update the NuGet packages (https://github.com/dependabot/dependabot-core/issues/13278) -->
        <TargetFramework>net10.0-windows</TargetFramework>
        <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
        <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageReference Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\NETworkManager.Models\NETworkManager.Models.csproj" />
    </ItemGroup>
</Project>
